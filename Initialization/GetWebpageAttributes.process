<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pfx="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd2" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:pfx2="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd4" xmlns:ns="http://www.tibco.com/namespaces/tnt/plugins/file" xmlns:pfx3="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd5" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns0="http://www.tibco.com/namespaces/tnt/plugins/file/v2" xmlns:ns2="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd3" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns1="http://www.tibco.com/pe/DeployedVarsType">
    <xsd:import namespace="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd3" schemaLocation="/Shared Resources/Data/Schemas/CodeNames.xsd"/>
    <xsd:import namespace="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd2" schemaLocation="/Shared Resources/Data/Schemas/ApplicationNames.xsd"/>
    <xsd:import namespace="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd4" schemaLocation="/Shared Resources/Data/Schemas/Personnels.xsd"/>
    <xsd:import namespace="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd5" schemaLocation="/Shared Resources/Data/Schemas/KEDBRef.xsd"/>
    <pd:name>Initialization/GetWebpageAttributes.process</pd:name>
    <pd:startName>File Poller</pd:startName>
    <pd:startX>0</pd:startX>
    <pd:startY>0</pd:startY>
    <pd:returnBindings/>
    <pd:starter name="File Poller">
        <pd:type>com.tibco.plugin.file.FileEventSource</pd:type>
        <pd:resourceType>ae.activities.FileEventSourceResource</pd:resourceType>
        <pd:x>196</pd:x>
        <pd:y>228</pd:y>
        <config>
            <pollInterval>%%Timer/Polling_sec%%</pollInterval>
            <createEvent>true</createEvent>
            <modifyEvent>true</modifyEvent>
            <deleteEvent>false</deleteEvent>
            <mode>only-files</mode>
            <encoding>text</encoding>
            <sortby>Date Modified</sortby>
            <sortorder>descending</sortorder>
            <fileName>%%Config_Files/Config_File_Dir%%</fileName>
            <includeCurrent>true</includeCurrent>
        </config>
        <pd:inputBindings/>
    </pd:starter>
    <pd:endName>End</pd:endName>
    <pd:endX>906</pd:endX>
    <pd:endY>221</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1762348975995</pd:targetNamespace>
    <pd:group name="Group">
        <pd:type>com.tibco.pe.core.LoopGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:x>279</pd:x>
        <pd:y>4</pd:y>
        <pd:width>579</pd:width>
        <pd:height>419</pd:height>
        <pd:collapsedWidth>52</pd:collapsedWidth>
        <pd:collapsedHeight>69</pd:collapsedHeight>
        <pd:groupVariables/>
        <config>
            <pd:groupType>simpleGroup</pd:groupType>
            <pd:serializable>false</pd:serializable>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Parse XML</pd:to>
            <pd:xpathDescription>CodeNames</pd:xpathDescription>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>contains($File-Poller/ns:EventSourceOuputTextClass/fileInfo/fileName,'CodeNames.xml')</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Parse-XML-1-2</pd:to>
            <pd:xpathDescription>KEDB Reference</pd:xpathDescription>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>contains($File-Poller/ns:EventSourceOuputTextClass/fileInfo/fileName,'KEBDRef.xml')</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Parse-XML-1-1</pd:to>
            <pd:xpathDescription>Assigned</pd:xpathDescription>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>contains($File-Poller/ns:EventSourceOuputTextClass/fileInfo/fileName,'Personnels.xml')</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>Parse-XML-1</pd:to>
            <pd:xpathDescription>ApplicationNames</pd:xpathDescription>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>xpath</pd:conditionType>
            <pd:xpath>contains($File-Poller/ns:EventSourceOuputTextClass/fileInfo/fileName,'ApplicationNames.xml')</pd:xpath>
        </pd:transition>
        <pd:transition>
            <pd:from>SetKEDB</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>SetCodenames</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>SetPersonnelName</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>SetApplicationNames</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>SelectCodeName</pd:from>
            <pd:to>SetCodenames</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Parse XML</pd:from>
            <pd:to>SelectCodeName</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Parse-XML-1-1</pd:from>
            <pd:to>SelectPersonnelName</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Parse-XML-1-2</pd:from>
            <pd:to>SelectKEDBRef</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Parse-XML-1</pd:from>
            <pd:to>SelectApplicationNames</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>SelectApplicationNames</pd:from>
            <pd:to>SetApplicationNames</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>SelectPersonnelName</pd:from>
            <pd:to>SetPersonnelName</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>SelectKEDBRef</pd:from>
            <pd:to>SetKEDB</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:activity name="Parse XML">
            <pd:type>com.tibco.plugin.xml.XMLParseActivity</pd:type>
            <pd:resourceType>ae.activities.XMLParseActivity</pd:resourceType>
            <pd:x>468</pd:x>
            <pd:y>68</pd:y>
            <config>
                <inputStyle>text</inputStyle>
                <xsdVersion>default</xsdVersion>
                <validateOutput>false</validateOutput>
                <term ref="ns2:CodeNameInfo"/>
            </config>
            <pd:inputBindings>
                <xmlString>
                    <xsl:value-of select="$File-Poller/ns:EventSourceOuputTextClass/fileContent/textContent"/>
                </xmlString>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Parse-XML-1-1">
            <pd:type>com.tibco.plugin.xml.XMLParseActivity</pd:type>
            <pd:resourceType>ae.activities.XMLParseActivity</pd:resourceType>
            <pd:x>468</pd:x>
            <pd:y>244</pd:y>
            <config>
                <inputStyle>text</inputStyle>
                <xsdVersion>default</xsdVersion>
                <validateOutput>false</validateOutput>
                <term ref="pfx2:AssignedInfo"/>
            </config>
            <pd:inputBindings>
                <xmlString>
                    <xsl:value-of select="$File-Poller/ns:EventSourceOuputTextClass/fileContent/textContent"/>
                </xmlString>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Parse-XML-1-2">
            <pd:type>com.tibco.plugin.xml.XMLParseActivity</pd:type>
            <pd:resourceType>ae.activities.XMLParseActivity</pd:resourceType>
            <pd:x>468</pd:x>
            <pd:y>345</pd:y>
            <config>
                <inputStyle>text</inputStyle>
                <xsdVersion>default</xsdVersion>
                <validateOutput>false</validateOutput>
                <term ref="pfx3:KEDBReferenceInfo"/>
            </config>
            <pd:inputBindings>
                <xmlString>
                    <xsl:value-of select="$File-Poller/ns:EventSourceOuputTextClass/fileContent/textContent"/>
                </xmlString>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="SelectCodeName">
            <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
            <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
            <pd:description>Each code name is URI-escaped (escape-uri) so quotes, backslashes and &lt;/script&gt; cannot break the page's JavaScript; the page decodes them with decodeURIComponent.</pd:description>
            <pd:x>569</pd:x>
            <pd:y>69</pd:y>
            <config>
                <element>
                    <xsd:element name="root">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="Item" type="xsd:string" minOccurs="0" maxOccurs="unbounded"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </element>
            </config>
            <pd:inputBindings>
                <root>
                    <xsl:for-each select="$Parse-XML/ns2:CodeNameInfo/ns2:CodeName/ns2:Name">
                        <Item>
                            <xsl:value-of select="translate(normalize-space(.), '&quot;\&lt;', '')"/>
                        </Item>
                    </xsl:for-each>
                </root>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="SelectKEDBRef">
            <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
            <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
            <pd:description>Builds the &lt;select&gt; as real XML so tib:render-xml escapes the names (&amp; &lt; &gt; quotes). Adds the "Select KEDB reference" placeholder (value="") first; a config entry with the same text is skipped.</pd:description>
            <pd:x>578</pd:x>
            <pd:y>347</pd:y>
            <config>
                <element>
                    <xsd:element name="select">
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="option" minOccurs="0" maxOccurs="unbounded">
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:extension base="xsd:string">
                                                        <xsd:attribute name="value" type="xsd:string"/>
                                                    </xsd:extension>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                    <xsd:attribute name="id" type="xsd:string"/>
                                    <xsd:attribute name="name" type="xsd:string"/>
                                </xsd:complexType>
                            </xsd:element>
                </element>
            </config>
            <pd:inputBindings>
                <select>
                    <xsl:attribute name="id">
                        <xsl:value-of select="'kedbReference'"/>
                    </xsl:attribute>
                    <xsl:attribute name="name">
                        <xsl:value-of select="'kedbReference'"/>
                    </xsl:attribute>
                    <option>
                        <xsl:attribute name="value">
                            <xsl:value-of select="''"/>
                        </xsl:attribute>
                        <xsl:value-of select="'Select KEDB reference'"/>
                    </option>
                    <xsl:for-each select="$Parse-XML-1-2/*[local-name()='KEBDReferenceInfo' or local-name()='KEDBReferenceInfo']/*[local-name()='KEBDReference' or local-name()='KEDBReference'][normalize-space(*[local-name()='Name']) != '' and normalize-space(*[local-name()='Name']) != 'Select KEDB reference']">
                        <option>
                            <xsl:attribute name="value">
                                <xsl:value-of select="normalize-space(*[local-name()='Name'])"/>
                            </xsl:attribute>
                            <xsl:value-of select="normalize-space(*[local-name()='Name'])"/>
                        </option>
                    </xsl:for-each>
                </select>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="SelectPersonnelName">
            <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
            <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
            <pd:description>Builds the &lt;select&gt; as real XML so tib:render-xml escapes the names (&amp; &lt; &gt; quotes). Adds the "Select assignee" placeholder (value="") first; a config entry with the same text is skipped.</pd:description>
            <pd:x>579</pd:x>
            <pd:y>245</pd:y>
            <config>
                <element>
                    <xsd:element name="select">
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="option" minOccurs="0" maxOccurs="unbounded">
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:extension base="xsd:string">
                                                        <xsd:attribute name="value" type="xsd:string"/>
                                                    </xsd:extension>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                    <xsd:attribute name="id" type="xsd:string"/>
                                    <xsd:attribute name="name" type="xsd:string"/>
                                </xsd:complexType>
                            </xsd:element>
                </element>
            </config>
            <pd:inputBindings>
                <select>
                    <xsl:attribute name="id">
                        <xsl:value-of select="'assigned'"/>
                    </xsl:attribute>
                    <xsl:attribute name="name">
                        <xsl:value-of select="'assigned'"/>
                    </xsl:attribute>
                    <option>
                        <xsl:attribute name="value">
                            <xsl:value-of select="''"/>
                        </xsl:attribute>
                        <xsl:value-of select="'Select assignee'"/>
                    </option>
                    <xsl:for-each select="$Parse-XML-1-1/pfx2:AssignedInfo/pfx2:Assigned[normalize-space(pfx2:Name) != '' and normalize-space(pfx2:Name) != 'Select assignee']">
                        <option>
                            <xsl:attribute name="value">
                                <xsl:value-of select="normalize-space(pfx2:Name)"/>
                            </xsl:attribute>
                            <xsl:value-of select="normalize-space(pfx2:Name)"/>
                        </option>
                    </xsl:for-each>
                </select>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="SetCodenames">
            <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
            <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
            <pd:x>692</pd:x>
            <pd:y>69</pd:y>
            <config>
                <variableConfig>/Shared Resources/Variables/CodeNames.sharedvariable</variableConfig>
            </config>
            <pd:inputBindings>
                <CodeNames>
                    <Content>
                        <xsl:value-of select="concat('const codeNameOptions = [&quot;', tib:concat-sequence-format($SelectCodeName/root/Item, '&quot;, &quot;'), '&quot;].map(function (s) { try { return decodeURIComponent(s); } catch (e) { return s; } });')"/>
                    </Content>
                </CodeNames>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="SelectApplicationNames">
            <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
            <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
            <pd:description>Builds the &lt;select&gt; as real XML so tib:render-xml escapes the names (&amp; &lt; &gt; quotes). Adds the "Select an application" placeholder (value="") first; a config entry with the same text is skipped.</pd:description>
            <pd:x>577</pd:x>
            <pd:y>154</pd:y>
            <config>
                <element>
                    <xsd:element name="select">
                                <xsd:complexType>
                                    <xsd:sequence>
                                        <xsd:element name="option" minOccurs="0" maxOccurs="unbounded">
                                            <xsd:complexType>
                                                <xsd:simpleContent>
                                                    <xsd:extension base="xsd:string">
                                                        <xsd:attribute name="value" type="xsd:string"/>
                                                    </xsd:extension>
                                                </xsd:simpleContent>
                                            </xsd:complexType>
                                        </xsd:element>
                                    </xsd:sequence>
                                    <xsd:attribute name="id" type="xsd:string"/>
                                    <xsd:attribute name="name" type="xsd:string"/>
                                </xsd:complexType>
                            </xsd:element>
                </element>
            </config>
            <pd:inputBindings>
                <select>
                    <xsl:attribute name="id">
                        <xsl:value-of select="'application'"/>
                    </xsl:attribute>
                    <xsl:attribute name="name">
                        <xsl:value-of select="'application'"/>
                    </xsl:attribute>
                    <option>
                        <xsl:attribute name="value">
                            <xsl:value-of select="''"/>
                        </xsl:attribute>
                        <xsl:value-of select="'Select an application'"/>
                    </option>
                    <xsl:for-each select="$Parse-XML-1/pfx:ApplicationInfo/pfx:ApplicationItem[normalize-space(pfx:Name) != '' and normalize-space(pfx:Name) != 'Select an application']">
                        <option>
                            <xsl:attribute name="value">
                                <xsl:value-of select="normalize-space(pfx:Name)"/>
                            </xsl:attribute>
                            <xsl:value-of select="normalize-space(pfx:Name)"/>
                        </option>
                    </xsl:for-each>
                </select>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Parse-XML-1">
            <pd:type>com.tibco.plugin.xml.XMLParseActivity</pd:type>
            <pd:resourceType>ae.activities.XMLParseActivity</pd:resourceType>
            <pd:x>461</pd:x>
            <pd:y>154</pd:y>
            <config>
                <inputStyle>text</inputStyle>
                <xsdVersion>default</xsdVersion>
                <validateOutput>false</validateOutput>
                <term ref="pfx:ApplicationInfo"/>
            </config>
            <pd:inputBindings>
                <xmlString>
                    <xsl:value-of select="$File-Poller/ns:EventSourceOuputTextClass/fileContent/textContent"/>
                </xmlString>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="SetApplicationNames">
            <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
            <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
            <pd:x>702</pd:x>
            <pd:y>154</pd:y>
            <config>
                <variableConfig>/Shared Resources/Variables/ApplicationNames.sharedvariable</variableConfig>
            </config>
            <pd:inputBindings>
                <ApplicationNames>
                    <content>
                        <xsl:value-of select="tib:render-xml($SelectApplicationNames/select, false())"/>
                    </content>
                </ApplicationNames>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="SetPersonnelName">
            <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
            <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
            <pd:x>701</pd:x>
            <pd:y>245</pd:y>
            <config>
                <variableConfig>/Shared Resources/Variables/Personnels.sharedvariable</variableConfig>
            </config>
            <pd:inputBindings>
                <Personnels>
                    <Content>
                        <xsl:value-of select="tib:render-xml($SelectPersonnelName/select, false())"/>
                    </Content>
                </Personnels>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="SetKEDB">
            <pd:type>com.tibco.pe.core.SetSharedVariableActivity</pd:type>
            <pd:resourceType>ae.activities.setSharedVariable</pd:resourceType>
            <pd:x>699</pd:x>
            <pd:y>346</pd:y>
            <config>
                <variableConfig>/Shared Resources/Variables/KEDBReferrence.sharedvariable</variableConfig>
            </config>
            <pd:inputBindings>
                <KEDBReferrence>
                    <Content>
                        <xsl:value-of select="tib:render-xml($SelectKEDBRef/select, false())"/>
                    </Content>
                </KEDBReferrence>
            </pd:inputBindings>
        </pd:activity>
    </pd:group>
    <pd:transition>
        <pd:from>File Poller</pd:from>
        <pd:to>Group</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Group</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>