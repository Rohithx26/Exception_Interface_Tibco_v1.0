<?xml version="1.0" encoding="UTF-8"?>
<BWSharedResource xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <name>User_Input_Data</name>
    <resourceType>ae.shared.ParseSharedResource</resourceType>
    <config xmlns:xsd="http://www.w3.org/2001/XMLSchema">
        <FormatType>Delimiter separated</FormatType>
        <ColumnSeparator>,</ColumnSeparator>
        <ColSeparatorRule>Treat all characters as entered as a single column separator string</ColSeparatorRule>
        <LineSeparator>
</LineSeparator>
        <FillCharacter>Space</FillCharacter>
        <LineLength>1</LineLength>
        <DataFormat>
            <xsd:element name="User_Input">
                <xsd:complexType>
                    <xsd:sequence>
                        <xsd:element name="application" type="xsd:string"/>
                        <xsd:element name="codeName" type="xsd:string"/>
                        <xsd:element name="date" type="xsd:string"/>
                        <xsd:element name="time" type="xsd:string"/>
                        <xsd:element name="description" type="xsd:string"/>
                        <xsd:element name="closeNotes" type="xsd:string"/>
                        <xsd:element name="assigned" type="xsd:string"/>
                        <xsd:element name="count" type="xsd:string"/>
                        <xsd:element name="kedbReference" type="xsd:string"/>
                        <xsd:element name="comments" type="xsd:string" minOccurs="0"/>
                    </xsd:sequence>
                </xsd:complexType>
            </xsd:element>
        </DataFormat>
    </config>
</BWSharedResource>