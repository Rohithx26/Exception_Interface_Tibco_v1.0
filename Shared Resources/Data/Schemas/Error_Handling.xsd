<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	 xmlns="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd"
	 targetNamespace="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd"
	 elementFormDefault="qualified"
	 attributeFormDefault="unqualified">
	<xs:element name="Error">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="ErrorCode"/>
				<xs:element ref="ErrorMessage"/>
				<xs:element ref="ProcessName"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ErrorCode" type="xs:string"/>
	<xs:element name="ErrorMessage" type="xs:string"/>
	<xs:element name="ProcessName" type="xs:string"/>
</xs:schema>