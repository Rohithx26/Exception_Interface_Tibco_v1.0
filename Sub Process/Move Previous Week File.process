<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns="http://www.tibco.com/pe/DeployedVarsType" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns2="http://www.tibco.com/namespaces/tnt/plugins/file">
    <pd:name>Sub Process/Move Previous Week File.process</pd:name>
    <pd:startName>Start</pd:startName>
    <pd:startX>202</pd:startX>
    <pd:startY>110</pd:startY>
    <pd:returnBindings/>
    <pd:endName>End</pd:endName>
    <pd:endX>673</pd:endX>
    <pd:endY>110</pd:endY>
    <pd:errorSchemas/>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1755872512804</pd:targetNamespace>
    <pd:activity name="List CSV file for Previous Week">
        <pd:type>com.tibco.plugin.file.ListFilesActivity</pd:type>
        <pd:resourceType>ae.activities.ListFilesActivity</pd:resourceType>
        <pd:x>332</pd:x>
        <pd:y>118</pd:y>
        <config>
            <mode>files-and-directories</mode>
        </config>
        <pd:inputBindings>
            <ns2:ListFilesActivityConfig>
                <fileName>
                    <xsl:value-of select="concat(&#xA;  $_globalVariables/ns:GlobalVariables/Directory/Working,$_globalVariables/ns:GlobalVariables/Directory/Filename,&#xA; tib:format-dateTime(&#xA;    'ddMMyyyy',&#xA;    tib:add-to-dateTime(&#xA;      current-dateTime(),&#xA;      0, 0,&#xA;      -(((number(tib:format-dateTime('u', current-dateTime())) + 3) mod 7) + 7),&#xA;      0, 0, 0&#xA;    )&#xA;  ),&#xA;$_globalVariables/ns:GlobalVariables/Directory/CSV_Wildcard&#xA;)"/>
                </fileName>
            </ns2:ListFilesActivityConfig>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Rename File">
        <pd:type>com.tibco.plugin.file.FileRenameActivity</pd:type>
        <pd:resourceType>ae.activities.FileRenameActivity</pd:resourceType>
        <pd:x>523</pd:x>
        <pd:y>113</pd:y>
        <config/>
        <pd:inputBindings>
            <ns2:RenameActivityConfig>
                <fromFileName>
                    <xsl:value-of select="$List-CSV-file-for-Previous-Week/ns2:ListFilesActivityOutput/files/fileInfo[1]/fullName"/>
                </fromFileName>
                <toFileName>
                    <xsl:value-of select="concat($_globalVariables/ns:GlobalVariables/Directory/Archive,$List-CSV-file-for-Previous-Week/ns2:ListFilesActivityOutput/files/fileInfo[1]/fileName)"/>
                </toFileName>
            </ns2:RenameActivityConfig>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>Start</pd:from>
        <pd:to>List CSV file for Previous Week</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Rename File</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>List CSV file for Previous Week</pd:from>
        <pd:to>Rename File</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>