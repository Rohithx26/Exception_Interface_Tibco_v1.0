    <pd:activity name="Intial Webpage content">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>566</pd:x>
        <pd:y>341</pd:y>
        <config>
            <element>
                <xsd:element name="root">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="param" type="xsd:string"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </element>
        </config>
        <pd:inputBindings>
            <root>
                <param>
                    <xsl:value-of select="concat(&#xA;'&lt;!DOCTYPE html>',&#xA;'&lt;html lang=&quot;en&quot;>',&#xA;'  &lt;head>',&#xA;'    &lt;meta charset=&quot;UTF-8&quot; />',&#xA;'    &lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot; />',&#xA;'    &lt;title>Exception Interface&lt;/title>',&#xA;'    &lt;style>',&#xA;'      body {',&#xA;'        font-family: &quot;Segoe UI&quot;, Arial, sans-serif;',&#xA;'        background: linear-gradient(120deg, #e9ecef 0%, #f5f6fa 100%);',&#xA;'        margin: 0;',&#xA;'        padding: 20px;',&#xA;'        display: flex;',&#xA;'        justify-content: center;',&#xA;'        align-items: center;',&#xA;'        min-height: 100vh;',&#xA;'      }',&#xA;'      .container {',&#xA;'        background: rgba(255, 255, 255, 0.92);',&#xA;'        border-radius: 18px;',&#xA;'        box-shadow: 0 8px 32px 0 rgba(44, 62, 80, 0.1), 0 1.5px 4px #bfc9d1;',&#xA;'        width: 95%;',&#xA;'        max-width: 600px;',&#xA;'        padding: 40px 30px 32px 30px;',&#xA;'        position: relative;',&#xA;'        overflow: hidden;',&#xA;'        border: 1.5px solid #e3e6ea;',&#xA;'        animation: fadeInUp 0.7s cubic-bezier(0.23, 1.01, 0.32, 1) both;',&#xA;'      }',&#xA;'      @keyframes fadeInUp {',&#xA;'        from { opacity: 0; transform: translateY(30px); }',&#xA;'        to { opacity: 1; transform: none; }',&#xA;'      }',&#xA;'      .container h1 {',&#xA;'        color: #2c3e50;',&#xA;'        font-weight: 400;',&#xA;'        margin-top: 0;',&#xA;'        margin-bottom: 25px;',&#xA;'        font-size: 28px;',&#xA;'        display: flex;',&#xA;'        align-items: center;',&#xA;'        letter-spacing: -0.5px;',&#xA;'        text-shadow: 0 1px 0 #f5f6fa;',&#xA;'      }',&#xA;'      label {',&#xA;'        display: block;',&#xA;'        margin-bottom: 10px;',&#xA;'        color: #6c7a89;',&#xA;'        font-size: 14px;',&#xA;'        font-weight: 500;',&#xA;'        letter-spacing: 0.3px;',&#xA;'      }',&#xA;'      input, select, textarea, .tibco-box select, .tibco-box input {',&#xA;'        width: 100%;',&#xA;'        padding: 12px 14px;',&#xA;'        border: 1.5px solid #e0e4e7;',&#xA;'        border-radius: 6px;',&#xA;'        background: #f7f8fa;',&#xA;'        font-size: 15px;',&#xA;'        color: #34495e;',&#xA;'        outline: none;',&#xA;'        transition: border-color 0.3s, box-shadow 0.3s;',&#xA;'        box-sizing: border-box;',&#xA;'        margin-bottom: 5px;',&#xA;'        box-shadow: 0 1px 2px #e9ecef inset;',&#xA;'      }',&#xA;'      input:focus, select:focus, textarea:focus, .tibco-box select:focus {',&#xA;'        border-color: #b2becd !important;',&#xA;'        box-shadow: 0 0 0 2px #e74c3c22 !important;',&#xA;'        background: #f3f4f7;',&#xA;'      }',&#xA;'      .input-error { border-color: #e74c3c !important; background: #fff0f0; }',&#xA;'      .error-message { color: #c0392b; font-size: 12px; margin-top: 2px; display: none; }',&#xA;'      .combobox-list { display: none; position: absolute; border: 1.5px solid #e0e4e7; border-top: none; max-height: 200px; overflow-y: auto; width: 100%; background-color: #fff; z-index: 100; box-shadow: 0 4px 12px rgba(44, 62, 80, 0.08); box-sizing: border-box; border-radius: 0 0 6px 6px; }',&#xA;'      .combobox-item { padding: 10px 18px; cursor: pointer; font-size: 15px; color: #34495e; transition: background 0.15s; }',&#xA;'      .combobox-item:hover { background-color: #f0f0f0; }',&#xA;'      .combobox-wrapper { position: relative; }',&#xA;'      button[type=&quot;submit&quot;] { background: linear-gradient(135deg, #e74c3c, #c0392b); color: white; border: none; padding: 14px 28px; border-radius: 6px; font-size: 15px; font-weight: 500; cursor: pointer; box-shadow: 0 4px 12px rgba(231, 76, 60, 0.18); letter-spacing: 0.5px; transition: background 0.2s, box-shadow 0.2s; }',&#xA;'      button[type=&quot;submit&quot;]:hover { background: linear-gradient(135deg, #c0392b, #e74c3c); box-shadow: 0 6px 18px rgba(231, 76, 60, 0.22); }',&#xA;'      #formErrorBanner { opacity: 0; transition: opacity 0.3s ease-in-out; }',&#xA;'      #formErrorBanner.show { opacity: 1; }',&#xA;'      @media (max-width: 768px) { .container { padding: 20px 5px; } h1 { font-size: 24px; } }',&#xA;'    &lt;/style>',&#xA;'  &lt;/head>',&#xA;'  &lt;body>',&#xA;'    &lt;div class=&quot;container&quot;>',&#xA;'      &lt;h1>&lt;span style=&quot;background: linear-gradient(135deg, #e74c3c, #c0392b); color: white; width: 42px; height: 42px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; margin-right: 15px; font-size: 20px; box-shadow: 0 3px 6px rgba(231, 76, 60, 0.18);&quot;>!&lt;/span> Exception Interface&lt;/h1>',&#xA;'      &lt;form id=&quot;exceptionForm&quot; action=&quot;/Success.html&quot; method=&quot;POST&quot; novalidate>',&#xA;'        &lt;div id=&quot;formErrorBanner&quot;>&lt;/div>',&#xA;'        ',&#xA;'        ',&#xA;'        &lt;div style=&quot;margin-bottom: 25px&quot;>',&#xA;'          &lt;label for=&quot;application&quot;>&lt;span style=&quot;color: #e74c3c; font-weight: bold&quot;>*&lt;/span> Application&lt;/label>',&#xA;'          &lt;div id=&quot;wrap_App&quot; class=&quot;tibco-box&quot;>',&#xA;$ApplicationNames/ApplicationNames/content,&#xA;'          &lt;/div>',&#xA;'          &lt;div class=&quot;error-message&quot; id=&quot;err_App&quot;>This field is required.&lt;/div>',&#xA;'        &lt;/div>',&#xA;'        ',&#xA;'        &lt;div style=&quot;margin-bottom: 25px&quot;>',&#xA;'          &lt;label for=&quot;codeNameInput&quot;>&lt;span style=&quot;color: #e74c3c; font-weight: bold&quot;>*&lt;/span> Code Name&lt;/label>',&#xA;'          &lt;div class=&quot;combobox-wrapper&quot;>',&#xA;'            &lt;input type=&quot;text&quot; id=&quot;codeNameInput&quot; name=&quot;codeName&quot; placeholder=&quot;Search or select an interface...&quot; autocomplete=&quot;off&quot; />',&#xA;'            &lt;div id=&quot;codeNameList&quot; class=&quot;combobox-list&quot;>&lt;/div>',&#xA;'          &lt;/div>',&#xA;'          &lt;div class=&quot;error-message&quot; id=&quot;codeNameError&quot;>This field is required.&lt;/div>',&#xA;'        &lt;/div>',&#xA;'        &lt;div style=&quot;margin-bottom: 25px&quot;>',&#xA;'          &lt;label for=&quot;datetime&quot;>&lt;span style=&quot;color: #e74c3c; font-weight: bold&quot;>*&lt;/span> Date &amp; Time&lt;/label>',&#xA;'          &lt;input type=&quot;datetime-local&quot; id=&quot;datetime&quot; name=&quot;datetime&quot; style=&quot;max-width: 300px&quot; />',&#xA;'          &lt;div class=&quot;error-message&quot; id=&quot;datetimeError&quot;>This field is required.&lt;/div>',&#xA;'        &lt;/div>',&#xA;'        &lt;div style=&quot;margin-bottom: 25px&quot;>',&#xA;'          &lt;label for=&quot;description&quot;>&lt;span style=&quot;color: #e74c3c; font-weight: bold&quot;>*&lt;/span> Description&lt;/label>',&#xA;'          &lt;textarea id=&quot;description&quot; name=&quot;description&quot; placeholder=&quot;Detailed description of the exception...&quot; maxlength=&quot;5000&quot; style=&quot;min-height: 100px; resize: vertical&quot;>&lt;/textarea>',&#xA;'          &lt;div class=&quot;error-message&quot; id=&quot;descriptionError&quot;>This field is required.&lt;/div>',&#xA;'        &lt;/div>',&#xA;'        &lt;div style=&quot;margin-bottom: 25px&quot;>',&#xA;'          &lt;label for=&quot;closeNotes&quot;>&lt;span style=&quot;color: #e74c3c; font-weight: bold&quot;>*&lt;/span> Close Notes&lt;/label>',&#xA;'          &lt;input type=&quot;text&quot; id=&quot;closeNotes&quot; name=&quot;closeNotes&quot; placeholder=&quot;Briefly describe the closing notes...&quot; maxlength=&quot;275&quot; />',&#xA;'          &lt;div class=&quot;error-message&quot; id=&quot;closeNotesError&quot;>This field is required.&lt;/div>',&#xA;'        &lt;/div>',&#xA;'        ',&#xA;'        ',&#xA;'        &lt;div style=&quot;margin-bottom: 25px&quot;>',&#xA;'          &lt;label for=&quot;assigned&quot;>&lt;span style=&quot;color: #e74c3c; font-weight: bold&quot;>*&lt;/span> Assigned&lt;/label>',&#xA;'          &lt;div id=&quot;wrap_Assigned&quot; class=&quot;tibco-box&quot;>',&#xA;$Personnels/Personnels/Content,&#xA;'          &lt;/div>',&#xA;'          &lt;div class=&quot;error-message&quot; id=&quot;err_Assigned&quot;>This field is required.&lt;/div>',&#xA;'        &lt;/div>',&#xA;'        ',&#xA;'        &lt;div style=&quot;margin-bottom: 25px&quot;>',&#xA;'          &lt;label for=&quot;count&quot;>&lt;span style=&quot;color: #e74c3c; font-weight: bold&quot;>*&lt;/span> Count&lt;/label>',&#xA;'          &lt;input type=&quot;number&quot; id=&quot;count&quot; name=&quot;count&quot; placeholder=&quot;Enter count&quot; min=&quot;0&quot; style=&quot;max-width: 200px&quot; />',&#xA;'          &lt;div class=&quot;error-message&quot; id=&quot;countError&quot;>This field is required.&lt;/div>',&#xA;'        &lt;/div>',&#xA;'        ',&#xA;'        ',&#xA;'        &lt;div style=&quot;margin-bottom: 25px&quot;>',&#xA;'          &lt;label for=&quot;kedbReference&quot;>&lt;span style=&quot;color: #e74c3c; font-weight: bold&quot;>*&lt;/span> KEDB Reference&lt;/label>',&#xA;'          &lt;div id=&quot;wrap_KEDB&quot; class=&quot;tibco-box&quot;>',&#xA;$KEDBReferrence/KEDBReferrence/Content,&#xA;'          &lt;/div>',&#xA;'          &lt;div class=&quot;error-message&quot; id=&quot;err_KEDB&quot;>This field is required.&lt;/div>',&#xA;'        &lt;/div>',&#xA;'        ',&#xA;'        &lt;div style=&quot;margin-bottom: 30px&quot;>',&#xA;'          &lt;label for=&quot;comments&quot;>Comments&lt;/label>',&#xA;'          &lt;textarea id=&quot;comments&quot; name=&quot;comments&quot; placeholder=&quot;Optional comments...&quot; maxlength=&quot;500&quot; style=&quot;min-height: 80px; resize: vertical&quot;>&lt;/textarea>',&#xA;'        &lt;/div>',&#xA;'        &lt;div style=&quot;text-align: right&quot;>&lt;button type=&quot;submit&quot;>Submit Exception&lt;/button>&lt;/div>',&#xA;'      &lt;/form>',&#xA;'    &lt;/div>',&#xA;'    &lt;script>',&#xA;$CodeNames/CodeNames/Content,&#xA;'      document.addEventListener(&quot;DOMContentLoaded&quot;, function() {',&#xA;'        ',&#xA;'        function getTibcoInput(wrapperId) {',&#xA;'           var wrapper = document.getElementById(wrapperId);',&#xA;'           if(!wrapper) return null;',&#xA;'           return wrapper.querySelector(&quot;select, input, textarea&quot;);',&#xA;'        }',&#xA;'        ',&#xA;'        /* UPDATED: validation now accepts an optional invalidPhrase */',&#xA;'        function validateItem(inputObj, errorId, invalidPhrase) {',&#xA;'           if (!inputObj) return false;',&#xA;'           var errorEl = document.getElementById(errorId);',&#xA;'           var val = inputObj.value.trim();',&#xA;'           ',&#xA;'           /* Fail if empty OR if value matches the &quot;Select...&quot; placeholder */',&#xA;'           var isInvalid = (!val || val === &quot;&quot; || (invalidPhrase &amp;&amp; val === invalidPhrase));',&#xA;'           ',&#xA;'           if (isInvalid) {',&#xA;'              inputObj.classList.add(&quot;input-error&quot;);',&#xA;'              if(errorEl) errorEl.style.display = &quot;block&quot;;',&#xA;'              return false;',&#xA;'           }',&#xA;'           inputObj.classList.remove(&quot;input-error&quot;);',&#xA;'           if(errorEl) errorEl.style.display = &quot;none&quot;;',&#xA;'           return true;',&#xA;'        }',&#xA;'        ',&#xA;'        function runAllValidations() {',&#xA;'           var isValid = true;',&#xA;'           ',&#xA;'           /* 1. TIBCO Dynamic Fields with SPECIFIC invalid phrases */',&#xA;'           var appIn = getTibcoInput(&quot;wrap_App&quot;);',&#xA;'           if (!validateItem(appIn, &quot;err_App&quot;, &quot;Select an application&quot;)) isValid = false;',&#xA;'           ',&#xA;'           var assignIn = getTibcoInput(&quot;wrap_Assigned&quot;);',&#xA;'           if (!validateItem(assignIn, &quot;err_Assigned&quot;, &quot;Select assignee&quot;)) isValid = false;',&#xA;'           ',&#xA;'           var kedbIn = getTibcoInput(&quot;wrap_KEDB&quot;);',&#xA;'           if (!validateItem(kedbIn, &quot;err_KEDB&quot;, &quot;Select KEDB reference&quot;)) isValid = false;',&#xA;'           ',&#xA;'           /* 2. Static Fields */',&#xA;'           if (!validateItem(document.getElementById(&quot;codeNameInput&quot;), &quot;codeNameError&quot;)) isValid = false;',&#xA;'           if (!validateItem(document.getElementById(&quot;datetime&quot;), &quot;datetimeError&quot;)) isValid = false;',&#xA;'           if (!validateItem(document.getElementById(&quot;description&quot;), &quot;descriptionError&quot;)) isValid = false;',&#xA;'           if (!validateItem(document.getElementById(&quot;closeNotes&quot;), &quot;closeNotesError&quot;)) isValid = false;',&#xA;'           ',&#xA;'           /* 3. Count */',&#xA;'           var countIn = document.getElementById(&quot;count&quot;);',&#xA;'           var countErr = document.getElementById(&quot;countError&quot;);',&#xA;'           var validCount = countIn.value.trim() !== &quot;&quot; &amp;&amp; Number(countIn.value) >= 0;',&#xA;'           if (!validCount) {',&#xA;'              countIn.classList.add(&quot;input-error&quot;);',&#xA;'              countErr.style.display = &quot;block&quot;;',&#xA;'              isValid = false;',&#xA;'           } else {',&#xA;'              countIn.classList.remove(&quot;input-error&quot;);',&#xA;'              countErr.style.display = &quot;none&quot;;',&#xA;'           }',&#xA;'           ',&#xA;'           return isValid;',&#xA;'        }',&#xA;'        ',&#xA;'        /* --- Listeners --- */',&#xA;'        var wrappers = [',&#xA;'           { w: &quot;wrap_App&quot;, e: &quot;err_App&quot;, bad: &quot;Select an application&quot; },',&#xA;'           { w: &quot;wrap_Assigned&quot;, e: &quot;err_Assigned&quot;, bad: &quot;Select assignee&quot; },',&#xA;'           { w: &quot;wrap_KEDB&quot;, e: &quot;err_KEDB&quot;, bad: &quot;Select KEDB reference&quot; }',&#xA;'        ];',&#xA;'        wrappers.forEach(function(item) {',&#xA;'           var el = getTibcoInput(item.w);',&#xA;'           if(el) {',&#xA;'              el.addEventListener(&quot;change&quot;, function() { validateItem(el, item.e, item.bad); });',&#xA;'              el.addEventListener(&quot;blur&quot;, function() { validateItem(el, item.e, item.bad); });',&#xA;'           }',&#xA;'        });',&#xA;'        ',&#xA;'        var statics = [',&#xA;'           { i: &quot;codeNameInput&quot;, e: &quot;codeNameError&quot; },',&#xA;'           { i: &quot;datetime&quot;, e: &quot;datetimeError&quot; },',&#xA;'           { i: &quot;description&quot;, e: &quot;descriptionError&quot; },',&#xA;'           { i: &quot;closeNotes&quot;, e: &quot;closeNotesError&quot; }',&#xA;'        ];',&#xA;'        statics.forEach(function(item) {',&#xA;'           var el = document.getElementById(item.i);',&#xA;'           if(el) {',&#xA;'              el.addEventListener(&quot;input&quot;, function() { validateItem(el, item.e); });',&#xA;'              el.addEventListener(&quot;blur&quot;, function() { validateItem(el, item.e); });',&#xA;'           }',&#xA;'        });',&#xA;'        ',&#xA;'        var countInput = document.getElementById(&quot;count&quot;);',&#xA;'        if(countInput) {',&#xA;'           countInput.addEventListener(&quot;input&quot;, function() {',&#xA;'               var valid = countInput.value.trim() !== &quot;&quot; &amp;&amp; Number(countInput.value) >= 0;',&#xA;'               var err = document.getElementById(&quot;countError&quot;);',&#xA;'               if (!valid) { countInput.classList.add(&quot;input-error&quot;); err.style.display = &quot;block&quot;; }',&#xA;'               else { countInput.classList.remove(&quot;input-error&quot;); err.style.display = &quot;none&quot;; }',&#xA;'           });',&#xA;'        }',&#xA;'        ',&#xA;'        var form = document.getElementById(&quot;exceptionForm&quot;);',&#xA;'        var banner = document.getElementById(&quot;formErrorBanner&quot;);',&#xA;'        ',&#xA;'        form.addEventListener(&quot;submit&quot;, function(e) {',&#xA;'           if (!runAllValidations()) {',&#xA;'              e.preventDefault();',&#xA;'              banner.textContent = &quot;⚠️ Please fill all required fields.&quot;;',&#xA;'              banner.classList.add(&quot;show&quot;);',&#xA;'              banner.style.display = &quot;block&quot;;',&#xA;'              setTimeout(function() { banner.classList.remove(&quot;show&quot;); banner.style.display = &quot;none&quot;; }, 4000);',&#xA;'           }',&#xA;'        });',&#xA;'        ',&#xA;'        /* Init Date and CodeName (Same as before) */',&#xA;'        var now = new Date();',&#xA;'        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());',&#xA;'        document.getElementById(&quot;datetime&quot;).value = now.toISOString().slice(0, 16);',&#xA;'        ',&#xA;'        var codeNameInput = document.getElementById(&quot;codeNameInput&quot;);',&#xA;'        var codeNameList = document.getElementById(&quot;codeNameList&quot;);',&#xA;'        function populateCodeNameList(options) {',&#xA;'          codeNameList.innerHTML = &quot;&quot;;',&#xA;'          options.forEach(function(option) {',&#xA;'            var div = document.createElement(&quot;div&quot;);',&#xA;'            div.className = &quot;combobox-item&quot;;',&#xA;'            div.textContent = option;',&#xA;'            div.addEventListener(&quot;mousedown&quot;, function(e) {',&#xA;'              e.preventDefault();',&#xA;'              codeNameInput.value = option;',&#xA;'              codeNameList.style.display = &quot;none&quot;;',&#xA;'              validateItem(codeNameInput, &quot;codeNameError&quot;);',&#xA;'            });',&#xA;'            codeNameList.appendChild(div);',&#xA;'          });',&#xA;'          codeNameList.style.display = options.length ? &quot;block&quot; : &quot;none&quot;;',&#xA;'        }',&#xA;'        codeNameInput.addEventListener(&quot;focus&quot;, function() {',&#xA;'           var filter = codeNameInput.value.toLowerCase();',&#xA;'           var filtered = (typeof codeNameOptions !== &quot;undefined&quot; ? codeNameOptions : []).filter(function(o) { return o.toLowerCase().includes(filter); });',&#xA;'           populateCodeNameList(filtered);',&#xA;'        });',&#xA;'        codeNameInput.addEventListener(&quot;keyup&quot;, function() {',&#xA;'           var filter = codeNameInput.value.toLowerCase();',&#xA;'           var filtered = (typeof codeNameOptions !== &quot;undefined&quot; ? codeNameOptions : []).filter(function(o) { return o.toLowerCase().includes(filter); });',&#xA;'           populateCodeNameList(filtered);',&#xA;'        });',&#xA;'        codeNameInput.addEventListener(&quot;blur&quot;, function() { setTimeout(function() { codeNameList.style.display = &quot;none&quot;; }, 150); });',&#xA;'      });',&#xA;'    &lt;/script>',&#xA;'  &lt;/body>',&#xA;'&lt;/html>'&#xA;)"/>
                </param>
            </root>
        </pd:inputBindings>
    </pd:activity>
