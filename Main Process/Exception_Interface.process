    <pd:activity name="Error End Log Audit">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>450</pd:x>
        <pd:y>551</pd:y>
        <config>
            <element>
                <xsd:element name="LogEntry">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="LogLine" type="xsd:string"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </element>
        </config>
        <pd:inputBindings>
            <LogEntry>
                <LogLine>
                    <xsl:value-of select="concat('ERROR | ', tib:format-dateTime('yyyy-MM-dd', current-dateTime()), ' | ', tib:format-dateTime('HH:mm:ss', current-dateTime()), ' | ', $UserData/Parameters/assigned, ' | ', tib:format-dateTime('yyyy-MM-dd', current-dateTime()), 'T', tib:format-dateTime('HH:mm:ss', current-dateTime()), ' | FileWrite: -1')"/>
                </LogLine>
            </LogEntry>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Error_Mail-1">
        <pd:type>com.tibco.pe.core.CallProcessActivity</pd:type>
        <pd:resourceType>ae.process.subprocess</pd:resourceType>
        <pd:x>747</pd:x>
        <pd:y>543</pd:y>
        <config>
            <processName>/Sub Process/Error_Handling.process</processName>
        </config>
        <pd:inputBindings>
            <xsl:choose>
                <xsl:when test="$_error_Render-User-Data/BadDataFormatException">
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="$_error_Render-User-Data/BadDataFormatException/msgCode"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="concat('Couldnt render data', &quot;&#xA;&quot;,$_error_Render-User-Data/BadDataFormatException/msg)"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="'Render User Data'"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:when>
                <xsl:when test="$_error_List-Files/ns2:FileNotFoundException">
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="$_error_List-Files/ns2:FileNotFoundException/msgCode"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="concat('Couldnt find the file',$_error_List-Files/ns2:FileNotFoundException/fileName)"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="'List Files'"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:when>
                <xsl:when test="$_error_Write-CSV-file/ActivityErrors/ns2:FileNotFoundException">
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="$_error_Write-CSV-file/ActivityErrors/ns2:FileNotFoundException/msgCode"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="concat('File not found','Filename:',$_error_Write-CSV-file/ActivityErrors/ns2:FileNotFoundException/fileName)"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="'Write CSV File'"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:when>
                <xsl:when test="$_error_Success_Page/ns3:HttpCommunicationException">
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="$_error_Success_Page/ns3:HttpCommunicationException/msgCode"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="'Error in Showing Success Response Webpage'"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="'Send Success HTTP Response'"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:when>
                <xsl:when test="$_error_Landing-Page/ns3:HttpCommunicationException">
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="$_error_Landing-Page/ns3:HttpCommunicationException/msgCode"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="'Error In Initial Landing Webpage'"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="'Landing Webpage'"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:when>
                <xsl:when test="$_error_Generate-Error/ns0:Error">
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="$_error_Generate-Error/ns0:Error/ns0:ErrorCode"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="$_error_Generate-Error/ns0:Error/ns0:ErrorMessage"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="$_error_Generate-Error/ns0:Error/ns0:ProcessName"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:when>
                <xsl:when test="$_error_Generate-Error-1/ns0:Error">
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="$_error_Generate-Error-1/ns0:Error/ns0:ErrorCode"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="$_error_Generate-Error-1/ns0:Error/ns0:ErrorMessage"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="$_error_Generate-Error-1/ns0:Error/ns0:ProcessName"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:when>
                <xsl:when test="$_error_Generate-Error-2/ns0:Error">
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="$_error_Generate-Error-2/ns0:Error/ns0:ErrorCode"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="$_error_Generate-Error-2/ns0:Error/ns0:ErrorMessage"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="$_error_Generate-Error-2/ns0:Error/ns0:ProcessName"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:when>
                <xsl:when test="$_error_Generate-Error-3/ns0:Error">
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="$_error_Generate-Error-3/ns0:Error/ns0:ErrorCode"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="$_error_Generate-Error-3/ns0:Error/ns0:ErrorMessage"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="$_error_Generate-Error-3/ns0:Error/ns0:ProcessName"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:when>
                <xsl:otherwise>
                    <ns0:Error>
                        <ns0:ErrorCode>
                            <xsl:value-of select="'TExcep-1001'"/>
                        </ns0:ErrorCode>
                        <ns0:ErrorMessage>
                            <xsl:value-of select="'Technical Interface Error'"/>
                        </ns0:ErrorMessage>
                        <ns0:ProcessName>
                            <xsl:value-of select="'Exception Interface'"/>
                        </ns0:ProcessName>
                    </ns0:Error>
                </xsl:otherwise>
            </xsl:choose>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Error_Page">
        <pd:type>com.tibco.plugin.http.HTTPResponseActivity</pd:type>
        <pd:resourceType>httppalette.httpWebResponse</pd:resourceType>
        <pd:x>651</pd:x>
        <pd:y>543</pd:y>
        <config>
            <closeConnection>true</closeConnection>
            <eventSource>HTTP Receiver</eventSource>
            <Headers>
                <xsd:element name="root">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="StatusLine" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Content-Type" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Set-Cookie" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Pragma" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Location" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </Headers>
        </config>
        <pd:inputBindings>
            <ResponseActivityInput>
                <asciiContent>
                    <xsl:value-of select="concat(&#xA;&#xA;'&lt;!DOCTYPE html>&lt;html lang=&quot;en&quot;>&lt;head>&lt;meta charset=&quot;UTF-8&quot; />',&#xA;&#xA;'&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot; />',&#xA;&#xA;'&lt;title>Submission Error&lt;/title>',&#xA;&#xA;'&lt;style>*{margin:0;padding:0;box-sizing:border-box;}',&#xA;&#xA;'body{font-family:&quot;Segoe UI&quot;,Tahoma,Geneva,Verdana,sans-serif;background:linear-gradient(135deg,#f5f7fa 0%,#e4edf5 100%);color:#333;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:20px;line-height:1.6;}',&#xA;&#xA;'.container{background:rgba(255,255,255,0.95);border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,0.08);width:95%;max-width:500px;padding:40px 35px;text-align:center;border:1px solid rgba(255,255,255,0.5);position:relative;overflow:hidden;}',&#xA;&#xA;'.container::before{content:&quot;&quot;;position:absolute;top:0;left:0;width:100%;height:5px;background:linear-gradient(90deg,#ff7b00,#ffaa00);}',&#xA;&#xA;'.error-icon{margin-bottom:20px;}',&#xA;&#xA;'h1{font-size:28px;color:#2c3e50;margin-bottom:15px;font-weight:600;}',&#xA;&#xA;'p{color:#5a6c7d;margin-bottom:25px;font-size:16px;}',&#xA;&#xA;'.email-info{background:#f8f9fa;border-radius:10px;padding:15px;margin:25px 0;border-left:4px solid #ff7b00;}',&#xA;&#xA;'.email-info p{margin-bottom:10px;font-size:15px;}',&#xA;&#xA;'.email-address{font-weight:600;color:#2c3e50;font-size:16px;}',&#xA;&#xA;'.btn{display:inline-block;background:linear-gradient(135deg,#ff7b00,#ffaa00);color:white;border:none;padding:14px 30px;border-radius:50px;font-size:16px;font-weight:600;cursor:pointer;transition:all 0.3s ease;box-shadow:0 4px 15px rgba(255,123,0,0.3);text-decoration:none;margin-top:10px;}',&#xA;&#xA;'.btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(255,123,0,0.4);}',&#xA;&#xA;'.btn:active{transform:translateY(0);}',&#xA;&#xA;'@media(max-width:480px){.container{padding:30px 20px;}h1{font-size:24px;}.error-icon svg{width:54px;height:54px;}}',&#xA;&#xA;'&lt;/style>&lt;/head>&lt;body>',&#xA;&#xA;'&lt;div class=&quot;container&quot;>',&#xA;&#xA;'&lt;div class=&quot;error-icon&quot;>',&#xA;&#xA;'&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; fill=&quot;#ff7b00&quot; viewBox=&quot;0 0 512 512&quot; width=&quot;64&quot; height=&quot;64&quot;>',&#xA;&#xA;'&lt;path d=&quot;M256 512A256 256 0 1 0 256 0a256 256 0 1 0 0 512zm0-384c13.3 0 24 10.7 24 24v112c0 13.3-10.7 24-24 24s-24-10.7-24-24V152c0-13.3 10.7-24 24-24zm0 256a32 32 0 1 1 0-64 32 32 0 1 1 0 64z&quot;/>',&#xA;&#xA;'&lt;/svg>',&#xA;&#xA;'&lt;/div>',&#xA;&#xA;'&lt;h1>Submission Error&lt;/h1>',&#xA;&#xA;'&lt;p>The exception data failed to submit. Please try again or contact support if the issue persists.&lt;/p>',&#xA;&#xA;'&lt;div class=&quot;email-info&quot;>&lt;p>Error details have been sent:&lt;/p>',&#xA;&#xA;'&lt;p class=&quot;email-address&quot;>', $_globalVariables/ns1:GlobalVariables/Mail/From, '&lt;/p>&lt;p>Please check your email for more information.&lt;/p>&lt;/div>',&#xA;&#xA;'&lt;a href=&quot;',$_globalVariables/ns1:GlobalVariables/URL/Base_URL,'&quot; class=&quot;btn&quot;>&amp;#8592; Return to Dashboard&lt;/a>',&#xA; &#xA;'&lt;/div>&lt;/body>&lt;/html>'&#xA; &#xA;)"/>
                </asciiContent>
                <Headers>
                    <Content-Type>
                        <xsl:value-of select="'text/html; charset=UTF-8'"/>
                    </Content-Type>
                </Headers>
            </ResponseActivityInput>
        </pd:inputBindings>
    </pd:activity>
