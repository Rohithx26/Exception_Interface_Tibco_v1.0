    <pd:activity name="Success_Page">
        <pd:type>com.tibco.plugin.http.HTTPResponseActivity</pd:type>
        <pd:resourceType>httppalette.httpWebResponse</pd:resourceType>
        <pd:x>819</pd:x>
        <pd:y>149</pd:y>
        <config>
            <closeConnection>true</closeConnection>
            <eventSource>HTTP Receiver</eventSource>
            <Headers>
                <xsd:element name="root">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="StatusLine" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Content-Type" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Set-Cookie" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Pragma" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Location" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </Headers>
        </config>
        <pd:inputBindings>
            <ResponseActivityInput>
                <asciiContent>
                    <xsl:value-of select="concat('&lt;!DOCTYPE html>&lt;html lang=&quot;en&quot;>&lt;head>&lt;meta charset=&quot;UTF-8&quot; />&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot; />&lt;title>Submission Success&lt;/title>&lt;link href=&quot;https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap&quot; rel=&quot;stylesheet&quot; />&lt;style>* { margin: 0; padding: 0; box-sizing: border-box; } body { background: linear-gradient( 135deg, #667eea 0%, #764ba2 50%, #f093fb 100% ); font-family: &quot;Inter&quot;, -apple-system, BlinkMacSystemFont, &quot;Segoe UI&quot;, sans-serif; min-height: 100vh; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; } body::before { content: &quot;&quot;; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient( circle at 20% 80%, rgba(120, 119, 198, 0.3) 0%, transparent 50% ), radial-gradient( circle at 80% 20%, rgba(255, 255, 255, 0.15) 0%, transparent 50% ), radial-gradient( circle at 40% 40%, rgba(120, 119, 198, 0.2) 0%, transparent 50% ); animation: float 20s ease-in-out infinite; z-index: 0; } @keyframes float { 0%, 100% { transform: translate(0px, 0px) rotate(0deg); } 33% { transform: translate(30px, -30px) rotate(120deg); } 66% { transform: translate(-20px, 20px) rotate(240deg); } } .container { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); border: 1px solid rgba(255, 255, 255, 0.3); border-radius: 24px; box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15), 0 15px 35px rgba(0, 0, 0, 0.1), inset 0 1px 0 rgba(255, 255, 255, 0.6); padding: 50px 40px; max-width: 420px; width: 90%; text-align: center; position: relative; z-index: 1; animation: slideInUp 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94); overflow: hidden; } .container::before { content: &quot;&quot;; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.4), transparent ); animation: shimmer 3s ease-in-out infinite; } @keyframes slideInUp { 0% { opacity: 0; transform: translateY(60px) scale(0.95); } 100% { opacity: 1; transform: translateY(0) scale(1); } } @keyframes shimmer { 0% { left: -100%; } 50% { left: 100%; } 100% { left: 100%; } } .success-icon { width: 80px; height: 80px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 28px; position: relative; animation: successBounce 1s cubic-bezier(0.68, -0.55, 0.265, 1.55); box-shadow: 0 10px 40px rgba(16, 185, 129, 0.4), 0 0 0 0 rgba(16, 185, 129, 0.7); } .success-icon::before { content: &quot;&quot;; position: absolute; width: 100%; height: 100%; border-radius: 50%; border: 2px solid #10b981; animation: ripple 2s ease-out infinite; } .success-icon::after { content: &quot;&quot;; position: absolute; width: 120%; height: 120%; border-radius: 50%; border: 1px solid rgba(16, 185, 129, 0.3); animation: ripple 2s ease-out infinite 1s; } @keyframes successBounce { 0% { transform: scale(0) rotate(-180deg); opacity: 0; } 50% { transform: scale(1.2) rotate(-90deg); opacity: 0.8; } 100% { transform: scale(1) rotate(0deg); opacity: 1; } } @keyframes ripple { 0% { transform: scale(1); opacity: 1; } 100% { transform: scale(1.5); opacity: 0; } } .success-icon .checkmark { color: white; font-size: 32px; font-weight: 700; animation: checkDraw 0.8s ease-out 0.3s both; } @keyframes checkDraw { 0% { transform: scale(0); opacity: 0; } 50% { transform: scale(1.3); opacity: 0.7; } 100% { transform: scale(1); opacity: 1; } } h2 { font-size: 2.2rem; font-weight: 700; margin-bottom: 18px; background: linear-gradient( 135deg, #1f2937 0%, #4f46e5 50%, #7c3aed 100% ); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: fadeInUp 0.8s ease-out 0.2s both; letter-spacing: -0.02em; } p { color: #6b7280; font-size: 1.15rem; line-height: 1.7; margin-bottom: 35px; animation: fadeInUp 0.8s ease-out 0.4s both; font-weight: 400; } a { display: inline-block; padding: 16px 36px; background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: white; text-decoration: none; border-radius: 12px; font-weight: 600; font-size: 1.05rem; transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94); box-shadow: 0 8px 32px rgba(59, 130, 246, 0.3), 0 2px 8px rgba(59, 130, 246, 0.2); position: relative; overflow: hidden; animation: fadeInUp 0.8s ease-out 0.6s both; } a::before { content: &quot;&quot;; position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient( 90deg, transparent, rgba(255, 255, 255, 0.2), transparent ); transition: left 0.5s; } a:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 15px 45px rgba(59, 130, 246, 0.4), 0 5px 15px rgba(59, 130, 246, 0.3); } a:hover::before { left: 100%; } a:active { transform: translateY(-1px) scale(1.01); } @keyframes fadeInUp { 0% { opacity: 0; transform: translateY(30px); } 100% { opacity: 1; transform: translateY(0); } } @keyframes fadeInDown { 0% { opacity: 0; transform: translateY(-20px); } 100% { opacity: 0.9; transform: translateY(0); } } @media (max-width: 500px) { .container { padding: 35px 25px; margin: 20px; border-radius: 20px; } h2 { font-size: 1.8rem; margin-bottom: 15px; } p { font-size: 1rem; margin-bottom: 30px; } .success-icon { width: 65px; height: 65px; margin-bottom: 25px; } .success-icon .checkmark { font-size: 26px; } a { padding: 14px 28px; font-size: 1rem; } } @media (prefers-contrast: high) { .container { background: white; border: 2px solid #000; } h2 { background: #000; -webkit-text-fill-color: transparent; } }&lt;/style>&lt;/head>&lt;body>&lt;div class=&quot;container&quot;>&lt;div class=&quot;success-icon&quot;>&lt;div class=&quot;checkmark&quot;>✓&lt;/div>&lt;/div>&lt;h2>Exception Submitted Successfully!&lt;/h2>&lt;p>Your exception report has been submitted and will be reviewed.&lt;/p>&lt;a href=&quot;/&quot;>Return to Dashboard&lt;/a>&lt;/div>&lt;/body>&lt;/html>', &quot;&quot;)"/>
                </asciiContent>
                <Headers>
                    <Content-Type>
                        <xsl:value-of select="'text/html; charset=UTF-8'"/>
                    </Content-Type>
                </Headers>
            </ResponseActivityInput>
        </pd:inputBindings>
    </pd:activity>
    <pd:activity name="Write Error End Log">
        <pd:type>com.tibco.plugin.file.FileWriteActivity</pd:type>
        <pd:resourceType>ae.activities.FileWriteActivity</pd:resourceType>
        <pd:x>551</pd:x>
        <pd:y>551</pd:y>
        <config>
            <encoding>text</encoding>
            <compressFile>None</compressFile>
            <append>true</append>
        </config>
        <pd:inputBindings>
            <ns:WriteActivityInputTextClass>
                <fileName>
                    <xsl:value-of select="concat($_globalVariables/ns1:GlobalVariables/Log/Directory, $_globalVariables/ns1:GlobalVariables/Log/Filename)"/>
                </fileName>
                <textContent>
                    <xsl:value-of select="concat($Error-End-Log-Audit/LogEntry/LogLine, '&#xA;')"/>
                </textContent>
            </ns:WriteActivityInputTextClass>
        </pd:inputBindings>
    </pd:activity>
    <pd:transition>
        <pd:from>HTTP Receiver</pd:from>
        <pd:to>CodeNames</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>otherwise</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Intial Webpage content</pd:from>
        <pd:to>Landing Page</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Error_Mail-1</pd:from>
        <pd:to>Null-1</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Null-1</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Error_Page</pd:from>
        <pd:to>Error_Mail-1</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Catch-1</pd:from>
        <pd:to>Error End Log Audit</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>CodeNames</pd:from>
        <pd:to>ApplicationNames</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ApplicationNames</pd:from>
        <pd:to>Personnels</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Personnels</pd:from>
        <pd:to>KEDBReferrence</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>KEDBReferrence</pd:from>
        <pd:to>Intial Webpage content</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>CodeNames</pd:from>
        <pd:to>Generate Error</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>error</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>ApplicationNames</pd:from>
        <pd:to>Generate-Error-1</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>error</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Personnels</pd:from>
        <pd:to>Generate-Error-2</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>error</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>KEDBReferrence</pd:from>
        <pd:to>Generate-Error-3</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>error</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Success_Page</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Landing Page</pd:from>
        <pd:to>End</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Error End Log Audit</pd:from>
        <pd:to>Write Error End Log</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>Write Error End Log</pd:from>
        <pd:to>Error_Page</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
    <pd:transition>
        <pd:from>HTTP Receiver</pd:from>
        <pd:to>Group</pd:to>
        <pd:xpathDescription>Valid</pd:xpathDescription>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16711936</pd:lineColor>
        <pd:conditionType>xpath</pd:conditionType>
        <pd:xpath>$HTTP-Receiver/ProcessStarterOutput/parameters/application!='' and 
$HTTP-Receiver/ProcessStarterOutput/parameters/codeName!='' and 
$HTTP-Receiver/ProcessStarterOutput/parameters/datetime!='' and 
$HTTP-Receiver/ProcessStarterOutput/parameters/description!='' and 
$HTTP-Receiver/ProcessStarterOutput/parameters/closeNotes!='' and
$HTTP-Receiver/ProcessStarterOutput/parameters/assigned!='' and
($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionType[1]='Emails' or $HTTP-Receiver/ProcessStarterOutput/parameters/exceptionType[1]='Monitoring Checks' or
 ($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionType[1]='Other' and normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionTypeOther[1])!='')) and
normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsReceived[1])!='' and translate(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsReceived[1]), '0123456789', '')='' and number(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsReceived[1])) >= 1 and
normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsFailed[1])!='' and translate(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsFailed[1]), '0123456789', '')='' and number(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsFailed[1])) >= 0 and
normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsProcessed[1])!='' and translate(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsProcessed[1]), '0123456789', '')='' and number(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsProcessed[1])) >= 1 and
$HTTP-Receiver/ProcessStarterOutput/parameters/kedbReference!=''</pd:xpath>
    </pd:transition>
    <pd:transition>
        <pd:from>Group</pd:from>
        <pd:to>Success_Page</pd:to>
        <pd:lineType>Default</pd:lineType>
        <pd:lineColor>-16777216</pd:lineColor>
        <pd:conditionType>always</pd:conditionType>
    </pd:transition>
</pd:ProcessDefinition>