    <pd:activity name="Intial Webpage content">
        <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
        <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
        <pd:x>566</pd:x>
        <pd:y>341</pd:y>
        <config>
            <element>
                <xsd:element name="root">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="param" type="xsd:string"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </element>
        </config>
        <pd:inputBindings>
            <root>
                <param>
                    <xsl:value-of select="concat(&#xA;'&lt;!DOCTYPE html>&#xA;',&#xA;'&lt;html lang=&quot;en&quot;>&#xA;',&#xA;'&lt;head>&#xA;',&#xA;'&lt;meta charset=&quot;UTF-8&quot; />&#xA;',&#xA;'&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot; />&#xA;',&#xA;'&lt;title>Exception Interface&lt;/title>&#xA;',&#xA;'&lt;style>&#xA;',&#xA;'  /* Layout: one centred sheet, fields grouped the way an incident is written up:&#xA;',&#xA;'     type and source, what happened, volumes, ownership. Red is reserved for errors. */&#xA;',&#xA;'  :root {&#xA;',&#xA;'    --bg: #eef1f5;&#xA;',&#xA;'    --surface: #ffffff;&#xA;',&#xA;'    --field: #f7f9fb;&#xA;',&#xA;'    --ink: #1b2533;&#xA;',&#xA;'    --muted: #5b6878;&#xA;',&#xA;'    --line: #d6dde6;&#xA;',&#xA;'    --accent: #1f5fae;&#xA;',&#xA;'    --accent-ink: #ffffff;&#xA;',&#xA;'    --accent-soft: #e2ebf7;&#xA;',&#xA;'    --ring: rgba(31, 95, 174, 0.28);&#xA;',&#xA;'    --danger: #b3261e;&#xA;',&#xA;'    --danger-soft: #fdecea;&#xA;',&#xA;'    --ok: #1e7a4c;&#xA;',&#xA;'    --shadow: 0 10px 28px rgba(16, 24, 40, 0.14);&#xA;',&#xA;'    --font-ui: &quot;Segoe UI&quot;, &quot;Segoe UI Variable&quot;, system-ui, -apple-system, &quot;Helvetica Neue&quot;, Arial, sans-serif;&#xA;',&#xA;'    --font-num: &quot;Cascadia Mono&quot;, Consolas, &quot;SFMono-Regular&quot;, Menlo, monospace;&#xA;',&#xA;'    color-scheme: light;&#xA;',&#xA;'  }&#xA;',&#xA;'  /* Dark theme: every colour is solid (no transparency), so native dropdown lists&#xA;',&#xA;'     and autofill never fall back to a white background with light text. */&#xA;',&#xA;'  @media (prefers-color-scheme: dark) {&#xA;',&#xA;'    :root:not([data-theme=&quot;light&quot;]) {&#xA;',&#xA;'      --bg: #0e1319; --surface: #161d26; --field: #1c2530; --ink: #e8edf3; --muted: #a6b2c0;&#xA;',&#xA;'      --line: #344254; --accent: #7cb0f2; --accent-ink: #0a1320; --accent-soft: #1d3150; --ring: rgba(124, 176, 242, 0.35);&#xA;',&#xA;'      --danger: #ff9488; --danger-soft: #3b2226; --ok: #6fd3a0; --shadow: 0 12px 32px rgba(0, 0, 0, 0.55); color-scheme: dark;&#xA;',&#xA;'    }&#xA;',&#xA;'  }&#xA;',&#xA;'  :root[data-theme=&quot;dark&quot;] {&#xA;',&#xA;'    --bg: #0e1319; --surface: #161d26; --field: #1c2530; --ink: #e8edf3; --muted: #a6b2c0;&#xA;',&#xA;'    --line: #344254; --accent: #7cb0f2; --accent-ink: #0a1320; --accent-soft: #1d3150; --ring: rgba(124, 176, 242, 0.35);&#xA;',&#xA;'    --danger: #ff9488; --danger-soft: #3b2226; --ok: #6fd3a0; --shadow: 0 12px 32px rgba(0, 0, 0, 0.55); color-scheme: dark;&#xA;',&#xA;'  }&#xA;',&#xA;'  * { box-sizing: border-box; }&#xA;',&#xA;'  body {&#xA;',&#xA;'    margin: 0; background: var(--bg); color: var(--ink); font: 15px/1.5 var(--font-ui);&#xA;',&#xA;'    padding-block: 32px 48px;&#xA;',&#xA;'    padding-left: max(16px, env(safe-area-inset-left, 0px));&#xA;',&#xA;'    padding-right: max(16px, env(safe-area-inset-right, 0px));&#xA;',&#xA;'  }&#xA;',&#xA;'  .sheet { max-width: 780px; margin: 0 auto; display: grid; gap: 16px; }&#xA;',&#xA;'  .masthead { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8px 24px; padding: 0 4px; }&#xA;',&#xA;'  .eyebrow { margin: 0; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }&#xA;',&#xA;'  h1 { margin: 2px 0 0; font-size: 28px; font-weight: 600; letter-spacing: -0.01em; text-wrap: balance; }&#xA;',&#xA;'  .week { margin: 0; font-size: 13px; color: var(--muted); }&#xA;',&#xA;'  .week strong { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }&#xA;',&#xA;'  form { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }&#xA;',&#xA;'  .banner { display: none; margin: 0; padding: 12px 24px; background: var(--danger-soft); color: var(--danger); font-weight: 600; border-bottom: 1px solid var(--line); }&#xA;',&#xA;'  .banner.show { display: block; }&#xA;',&#xA;'  fieldset { border: 0; margin: 0; padding: 22px 24px 24px; display: grid; gap: 18px; }&#xA;',&#xA;'  fieldset + fieldset { border-top: 1px solid var(--line); }&#xA;',&#xA;'  legend { float: left; width: 100%; padding: 0; margin: 0 0 2px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }&#xA;',&#xA;'  legend + * { clear: both; }&#xA;',&#xA;'  .row { display: grid; gap: 18px; grid-template-columns: 1fr; }&#xA;',&#xA;'  @media (min-width: 640px) {&#xA;',&#xA;'    .row.two { grid-template-columns: 1fr 1fr; }&#xA;',&#xA;'    .row.three { grid-template-columns: repeat(3, 1fr); }&#xA;',&#xA;'  }&#xA;',&#xA;'  .field { display: grid; gap: 6px; min-width: 0; align-content: start; }&#xA;',&#xA;'  label, .label { font-size: 13px; font-weight: 600; color: var(--ink); }&#xA;',&#xA;'  .req { color: var(--danger); margin-left: 2px; }&#xA;',&#xA;'  .hint { font-size: 12px; color: var(--muted); }&#xA;',&#xA;'  input[type=&quot;text&quot;], input[type=&quot;datetime-local&quot;], select, textarea {&#xA;',&#xA;'    width: 100%; font: inherit; color: var(--ink); background: var(--field);&#xA;',&#xA;'    border: 1px solid var(--line); border-radius: 8px; padding: 10px 12px; min-height: 42px;&#xA;',&#xA;'    transition: border-color 0.15s, box-shadow 0.15s;&#xA;',&#xA;'  }&#xA;',&#xA;'  textarea { resize: vertical; min-height: 110px; }&#xA;',&#xA;'  textarea.short { min-height: 72px; }&#xA;',&#xA;'  /* Native dropdown list: always solid theme colours, in every state */&#xA;',&#xA;'  select option, select optgroup { background-color: var(--surface); color: var(--ink); }&#xA;',&#xA;'  select option[value=&quot;&quot;] { color: var(--muted); }&#xA;',&#xA;'  input::placeholder, textarea::placeholder { color: var(--muted); opacity: 1; }&#xA;',&#xA;'  input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--ring); }&#xA;',&#xA;'  .invalid input, .invalid select, .invalid textarea { border-color: var(--danger); background-color: var(--danger-soft); color: var(--ink); }&#xA;',&#xA;'  .invalid input:focus, .invalid select:focus, .invalid textarea:focus { box-shadow: 0 0 0 3px var(--danger-soft); }&#xA;',&#xA;'  .error { display: none; font-size: 12px; font-weight: 600; color: var(--danger); }&#xA;',&#xA;'  .error::before { content: &quot;! &quot;; font-weight: 800; }&#xA;',&#xA;'  .invalid .error { display: block; }&#xA;',&#xA;'  /* Exception type: segmented choice */&#xA;',&#xA;'  .segments { display: flex; flex-wrap: wrap; gap: 8px; }&#xA;',&#xA;'  .segments input { position: absolute; opacity: 0; width: 1px; height: 1px; }&#xA;',&#xA;'  .segments label {&#xA;',&#xA;'    display: inline-flex; align-items: center; gap: 8px; cursor: pointer; font-weight: 500;&#xA;',&#xA;'    padding: 9px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--field);&#xA;',&#xA;'  }&#xA;',&#xA;'  .segments label::before { content: &quot;&quot;; width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--muted); flex: none; }&#xA;',&#xA;'  .segments input:checked + label { border-color: var(--accent); background: var(--accent-soft); color: var(--ink); }&#xA;',&#xA;'  .segments input:checked + label::before { border-color: var(--accent); background: radial-gradient(var(--accent) 45%, transparent 50%); }&#xA;',&#xA;'  .segments input:focus-visible + label { box-shadow: 0 0 0 3px var(--ring); border-color: var(--accent); }&#xA;',&#xA;'  .invalid .segments label { border-color: var(--danger); }&#xA;',&#xA;'  .other[hidden] { display: none !important; }&#xA;',&#xA;'  /* Volumes: three counters */&#xA;',&#xA;'  .count input { font-family: var(--font-num); font-size: 20px; font-variant-numeric: tabular-nums; text-align: right; }&#xA;',&#xA;'  /* Code name search */&#xA;',&#xA;'  .combo { position: relative; }&#xA;',&#xA;'  .combo-list { display: none; position: absolute; left: 0; right: 0; top: calc(100% + 4px); z-index: 20; max-height: 220px; overflow-y: auto;&#xA;',&#xA;'    background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 8px; box-shadow: var(--shadow); }&#xA;',&#xA;'  .combo-list.open { display: block; }&#xA;',&#xA;'  .combo-item { padding: 9px 12px; cursor: pointer; overflow-wrap: anywhere; }&#xA;',&#xA;'  .combo-item:hover, .combo-item.active { background: var(--accent-soft); }&#xA;',&#xA;'  .combo-empty { padding: 9px 12px; color: var(--muted); }&#xA;',&#xA;'  .actions { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: center; gap: 12px; padding: 16px 24px; border-top: 1px solid var(--line); background: var(--field); }&#xA;',&#xA;'  .actions .hint { margin-right: auto; }&#xA;',&#xA;'  button { font: inherit; font-weight: 600; border-radius: 8px; padding: 10px 18px; cursor: pointer; min-height: 42px; }&#xA;',&#xA;'  .btn-primary { background: var(--accent); color: var(--accent-ink); border: 1px solid var(--accent); }&#xA;',&#xA;'  .btn-primary:hover { filter: brightness(1.08); }&#xA;',&#xA;'  .btn-quiet { background: transparent; color: var(--muted); border: 1px solid var(--line); }&#xA;',&#xA;'  .btn-quiet:hover { color: var(--ink); }&#xA;',&#xA;'  button:focus-visible { outline: 3px solid var(--ring); outline-offset: 2px; }&#xA;',&#xA;'  @media (prefers-reduced-motion: reduce) { * { transition: none !important; } }&#xA;',&#xA;'&lt;/style>&#xA;',&#xA;'&lt;/head>&#xA;',&#xA;'&lt;body>&#xA;',&#xA;'&lt;div class=&quot;sheet&quot;>&#xA;',&#xA;'  &lt;header class=&quot;masthead&quot;>&#xA;',&#xA;'    &lt;div>&#xA;',&#xA;'      &lt;p class=&quot;eyebrow&quot;>TIBCO Support&lt;/p>&#xA;',&#xA;'      &lt;h1>Exception Interface&lt;/h1>&#xA;',&#xA;'    &lt;/div>&#xA;',&#xA;'    &lt;p class=&quot;week&quot;>Reporting week &lt;strong id=&quot;weekRange&quot;>Thu – Wed&lt;/strong>&lt;/p>&#xA;',&#xA;'  &lt;/header>&#xA;',&#xA;'  &lt;form id=&quot;exceptionForm&quot; action=&quot;/Success.html&quot; method=&quot;POST&quot; novalidate>&#xA;',&#xA;'    &lt;p id=&quot;formErrorBanner&quot; class=&quot;banner&quot; role=&quot;alert&quot;>&lt;/p>&#xA;',&#xA;if ($HTTP-Receiver/ProcessStarterOutput/parameters/*[normalize-space(.) != '']) then '&lt;p id=&quot;serverRejectBanner&quot; class=&quot;banner show&quot; role=&quot;alert&quot;>This exception was not saved: a required field was missing or invalid. Fill in the form and submit again.&lt;/p>' else '',&#xA;'&#xA;',&#xA;'    &lt;fieldset>&#xA;',&#xA;'      &lt;legend>Type and source&lt;/legend>&#xA;',&#xA;'      &lt;div class=&quot;field&quot; id=&quot;f_type&quot;>&#xA;',&#xA;'        &lt;span class=&quot;label&quot; id=&quot;typeLabel&quot;>Exception type&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/span>&#xA;',&#xA;'        &lt;div class=&quot;segments&quot; role=&quot;radiogroup&quot; aria-labelledby=&quot;typeLabel&quot;>&#xA;',&#xA;'          &lt;input type=&quot;radio&quot; id=&quot;type_emails&quot; name=&quot;exceptionType&quot; value=&quot;Emails&quot; />&lt;label for=&quot;type_emails&quot;>Emails&lt;/label>&#xA;',&#xA;'          &lt;input type=&quot;radio&quot; id=&quot;type_monitoring&quot; name=&quot;exceptionType&quot; value=&quot;Monitoring Checks&quot; />&lt;label for=&quot;type_monitoring&quot;>Monitoring Checks&lt;/label>&#xA;',&#xA;'          &lt;input type=&quot;radio&quot; id=&quot;type_other&quot; name=&quot;exceptionType&quot; value=&quot;Other&quot; />&lt;label for=&quot;type_other&quot;>Other&lt;/label>&#xA;',&#xA;'        &lt;/div>&#xA;',&#xA;'        &lt;span class=&quot;error&quot;>Choose the exception type.&lt;/span>&#xA;',&#xA;'      &lt;/div>&#xA;',&#xA;'      &lt;div class=&quot;field other&quot; id=&quot;f_typeOther&quot; hidden>&#xA;',&#xA;'        &lt;label for=&quot;exceptionTypeOther&quot;>Other exception type&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'        &lt;input type=&quot;text&quot; id=&quot;exceptionTypeOther&quot; name=&quot;exceptionTypeOther&quot; maxlength=&quot;100&quot; placeholder=&quot;Describe the type, e.g. Batch job alert&quot; disabled />&#xA;',&#xA;'        &lt;span class=&quot;error&quot;>Describe the exception type.&lt;/span>&#xA;',&#xA;'      &lt;/div>&#xA;',&#xA;'      &lt;div class=&quot;row two&quot;>&#xA;',&#xA;'        &lt;div class=&quot;field&quot; id=&quot;f_app&quot;>&#xA;',&#xA;'          &lt;label for=&quot;application&quot;>Application&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'          &lt;div id=&quot;wrap_App&quot;>&#xA;',&#xA;$ApplicationNames/ApplicationNames/content,&#xA;'&#xA;',&#xA;'          &lt;/div>&#xA;',&#xA;'          &lt;span class=&quot;error&quot;>Choose an application.&lt;/span>&#xA;',&#xA;'        &lt;/div>&#xA;',&#xA;'        &lt;div class=&quot;field&quot; id=&quot;f_code&quot;>&#xA;',&#xA;'          &lt;label for=&quot;codeNameInput&quot;>Code name&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'          &lt;div class=&quot;combo&quot;>&#xA;',&#xA;'            &lt;input type=&quot;text&quot; id=&quot;codeNameInput&quot; name=&quot;codeName&quot; placeholder=&quot;Search interfaces&quot; autocomplete=&quot;off&quot; role=&quot;combobox&quot; aria-autocomplete=&quot;list&quot; aria-expanded=&quot;false&quot; aria-controls=&quot;codeNameList&quot; />&#xA;',&#xA;'            &lt;div id=&quot;codeNameList&quot; class=&quot;combo-list&quot; role=&quot;listbox&quot;>&lt;/div>&#xA;',&#xA;'          &lt;/div>&#xA;',&#xA;'          &lt;span class=&quot;error&quot;>Enter or pick a code name.&lt;/span>&#xA;',&#xA;'        &lt;/div>&#xA;',&#xA;'      &lt;/div>&#xA;',&#xA;'    &lt;/fieldset>&#xA;',&#xA;'    &lt;fieldset>&#xA;',&#xA;'      &lt;legend>What happened&lt;/legend>&#xA;',&#xA;'      &lt;div class=&quot;field&quot; id=&quot;f_datetime&quot;>&#xA;',&#xA;'        &lt;label for=&quot;datetime&quot;>Date and time&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'        &lt;input type=&quot;datetime-local&quot; id=&quot;datetime&quot; name=&quot;datetime&quot; style=&quot;max-width: 280px&quot; />&#xA;',&#xA;'        &lt;span class=&quot;error&quot;>Enter the date and time.&lt;/span>&#xA;',&#xA;'      &lt;/div>&#xA;',&#xA;'      &lt;div class=&quot;field&quot; id=&quot;f_description&quot;>&#xA;',&#xA;'        &lt;label for=&quot;description&quot;>Description&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'        &lt;textarea id=&quot;description&quot; name=&quot;description&quot; maxlength=&quot;5000&quot; placeholder=&quot;What failed and what you saw. Text pasted from the alert email is fine.&quot;>&lt;/textarea>&#xA;',&#xA;'        &lt;span class=&quot;error&quot;>Describe the exception.&lt;/span>&#xA;',&#xA;'      &lt;/div>&#xA;',&#xA;'      &lt;div class=&quot;field&quot; id=&quot;f_closeNotes&quot;>&#xA;',&#xA;'        &lt;label for=&quot;closeNotes&quot;>Close notes&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'        &lt;input type=&quot;text&quot; id=&quot;closeNotes&quot; name=&quot;closeNotes&quot; maxlength=&quot;275&quot; placeholder=&quot;How it was resolved&quot; />&#xA;',&#xA;'        &lt;span class=&quot;error&quot;>Add the close notes.&lt;/span>&#xA;',&#xA;'      &lt;/div>&#xA;',&#xA;'    &lt;/fieldset>&#xA;',&#xA;'    &lt;fieldset>&#xA;',&#xA;'      &lt;legend>Volumes&lt;/legend>&#xA;',&#xA;'      &lt;div class=&quot;row three&quot;>&#xA;',&#xA;'        &lt;div class=&quot;field count&quot; id=&quot;f_received&quot;>&#xA;',&#xA;'          &lt;label for=&quot;exceptionsReceived&quot;>Exceptions received&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'          &lt;input type=&quot;text&quot; id=&quot;exceptionsReceived&quot; name=&quot;exceptionsReceived&quot; inputmode=&quot;numeric&quot; pattern=&quot;[0-9]*&quot; maxlength=&quot;9&quot; autocomplete=&quot;off&quot; placeholder=&quot;0&quot; />&#xA;',&#xA;'          &lt;span class=&quot;error&quot;>Whole number, 1 or more.&lt;/span>&#xA;',&#xA;'        &lt;/div>&#xA;',&#xA;'        &lt;div class=&quot;field count&quot; id=&quot;f_failed&quot;>&#xA;',&#xA;'          &lt;label for=&quot;exceptionsFailed&quot;>Exceptions failed&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'          &lt;input type=&quot;text&quot; id=&quot;exceptionsFailed&quot; name=&quot;exceptionsFailed&quot; inputmode=&quot;numeric&quot; pattern=&quot;[0-9]*&quot; maxlength=&quot;9&quot; autocomplete=&quot;off&quot; placeholder=&quot;0&quot; />&#xA;',&#xA;'          &lt;span class=&quot;error&quot;>Whole number, 0 or more.&lt;/span>&#xA;',&#xA;'        &lt;/div>&#xA;',&#xA;'        &lt;div class=&quot;field count&quot; id=&quot;f_processed&quot;>&#xA;',&#xA;'          &lt;label for=&quot;exceptionsProcessed&quot;>Exceptions processed&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'          &lt;input type=&quot;text&quot; id=&quot;exceptionsProcessed&quot; name=&quot;exceptionsProcessed&quot; inputmode=&quot;numeric&quot; pattern=&quot;[0-9]*&quot; maxlength=&quot;9&quot; autocomplete=&quot;off&quot; placeholder=&quot;0&quot; />&#xA;',&#xA;'          &lt;span class=&quot;error&quot;>Whole number, 1 or more.&lt;/span>&#xA;',&#xA;'        &lt;/div>&#xA;',&#xA;'      &lt;/div>&#xA;',&#xA;'    &lt;/fieldset>&#xA;',&#xA;'    &lt;fieldset>&#xA;',&#xA;'      &lt;legend>Ownership&lt;/legend>&#xA;',&#xA;'      &lt;div class=&quot;row two&quot;>&#xA;',&#xA;'        &lt;div class=&quot;field&quot; id=&quot;f_assigned&quot;>&#xA;',&#xA;'          &lt;label for=&quot;assigned&quot;>Assigned to&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'          &lt;div id=&quot;wrap_Assigned&quot;>&#xA;',&#xA;$Personnels/Personnels/Content,&#xA;'&#xA;',&#xA;'          &lt;/div>&#xA;',&#xA;'          &lt;span class=&quot;error&quot;>Choose who handled it.&lt;/span>&#xA;',&#xA;'        &lt;/div>&#xA;',&#xA;'        &lt;div class=&quot;field&quot; id=&quot;f_kedb&quot;>&#xA;',&#xA;'          &lt;label for=&quot;kedbReference&quot;>KEDB reference&lt;span class=&quot;req&quot;>*&lt;/span>&lt;/label>&#xA;',&#xA;'          &lt;div id=&quot;wrap_KEDB&quot;>&#xA;',&#xA;$KEDBReferrence/KEDBReferrence/Content,&#xA;'&#xA;',&#xA;'          &lt;/div>&#xA;',&#xA;'          &lt;span class=&quot;error&quot;>Choose a KEDB reference.&lt;/span>&#xA;',&#xA;'        &lt;/div>&#xA;',&#xA;'      &lt;/div>&#xA;',&#xA;'      &lt;div class=&quot;field&quot;>&#xA;',&#xA;'        &lt;label for=&quot;comments&quot;>Comments &lt;span class=&quot;hint&quot;>(optional)&lt;/span>&lt;/label>&#xA;',&#xA;'        &lt;textarea id=&quot;comments&quot; name=&quot;comments&quot; class=&quot;short&quot; maxlength=&quot;500&quot; placeholder=&quot;Anything else the team should know&quot;>&lt;/textarea>&#xA;',&#xA;'      &lt;/div>&#xA;',&#xA;'    &lt;/fieldset>&#xA;',&#xA;'    &lt;div class=&quot;actions&quot;>&#xA;',&#xA;'      &lt;span class=&quot;hint&quot;>&lt;span class=&quot;req&quot;>*&lt;/span> Required&lt;/span>&#xA;',&#xA;'      &lt;button type=&quot;reset&quot; class=&quot;btn-quiet&quot;>Clear form&lt;/button>&#xA;',&#xA;'      &lt;button type=&quot;submit&quot; class=&quot;btn-primary&quot;>Submit exception&lt;/button>&#xA;',&#xA;'    &lt;/div>&#xA;',&#xA;'  &lt;/form>&#xA;',&#xA;'&lt;/div>&#xA;',&#xA;'&lt;script>&#xA;',&#xA;$CodeNames/CodeNames/Content,&#xA;'&#xA;',&#xA;'(function () {&#xA;',&#xA;'  var form = document.getElementById(&quot;exceptionForm&quot;);&#xA;',&#xA;'  var banner = document.getElementById(&quot;formErrorBanner&quot;);&#xA;',&#xA;'  var otherBox = document.getElementById(&quot;f_typeOther&quot;);&#xA;',&#xA;'  var otherInput = document.getElementById(&quot;exceptionTypeOther&quot;);&#xA;',&#xA;'  var codeInput = document.getElementById(&quot;codeNameInput&quot;);&#xA;',&#xA;'  var codeList = document.getElementById(&quot;codeNameList&quot;);&#xA;',&#xA;'  var options = (typeof codeNameOptions !== &quot;undefined&quot;) ? codeNameOptions.filter(function (o) { return o !== &quot;&quot;; }) : [];&#xA;',&#xA;'  var placeholders = { application: &quot;Select an application&quot;, assigned: &quot;Select assignee&quot;, kedbReference: &quot;Select KEDB reference&quot; };&#xA;',&#xA;'  var countIds = [&quot;exceptionsReceived&quot;, &quot;exceptionsFailed&quot;, &quot;exceptionsProcessed&quot;];&#xA;',&#xA;'  function mark(fieldId, ok) {&#xA;',&#xA;'    var el = document.getElementById(fieldId);&#xA;',&#xA;'    if (el) { el.classList.toggle(&quot;invalid&quot;, !ok); }&#xA;',&#xA;'    return ok;&#xA;',&#xA;'  }&#xA;',&#xA;'  function filled(id) {&#xA;',&#xA;'    var el = document.getElementById(id);&#xA;',&#xA;'    var v = el ? el.value.trim() : &quot;&quot;;&#xA;',&#xA;'    return v !== &quot;&quot; &amp;&amp; v !== placeholders[id];&#xA;',&#xA;'  }&#xA;',&#xA;'  function selectedType() {&#xA;',&#xA;'    var r = form.querySelector(&quot;input[name=exceptionType]:checked&quot;);&#xA;',&#xA;'    return r ? r.value : &quot;&quot;;&#xA;',&#xA;'  }&#xA;',&#xA;'  /* Failed may be 0; Received and Processed must be 1 or more */&#xA;',&#xA;'  var countMin = { exceptionsReceived: 1, exceptionsFailed: 0, exceptionsProcessed: 1 };&#xA;',&#xA;'  function validCount(id) {&#xA;',&#xA;'    var v = document.getElementById(id).value.trim();&#xA;',&#xA;'    return /^[0-9]+$/.test(v) &amp;&amp; parseInt(v, 10) >= countMin[id];&#xA;',&#xA;'  }&#xA;',&#xA;'  var checks = {&#xA;',&#xA;'    f_type: function () { return selectedType() !== &quot;&quot;; },&#xA;',&#xA;'    f_typeOther: function () { return selectedType() !== &quot;Other&quot; || otherInput.value.trim() !== &quot;&quot;; },&#xA;',&#xA;'    f_app: function () { return filled(&quot;application&quot;); },&#xA;',&#xA;'    f_code: function () { return filled(&quot;codeNameInput&quot;); },&#xA;',&#xA;'    f_datetime: function () { return filled(&quot;datetime&quot;); },&#xA;',&#xA;'    f_description: function () { return filled(&quot;description&quot;); },&#xA;',&#xA;'    f_closeNotes: function () { return filled(&quot;closeNotes&quot;); },&#xA;',&#xA;'    f_received: function () { return validCount(&quot;exceptionsReceived&quot;); },&#xA;',&#xA;'    f_failed: function () { return validCount(&quot;exceptionsFailed&quot;); },&#xA;',&#xA;'    f_processed: function () { return validCount(&quot;exceptionsProcessed&quot;); },&#xA;',&#xA;'    f_assigned: function () { return filled(&quot;assigned&quot;); },&#xA;',&#xA;'    f_kedb: function () { return filled(&quot;kedbReference&quot;); }&#xA;',&#xA;'  };&#xA;',&#xA;'  function check(fieldId) { return mark(fieldId, checks[fieldId]()); }&#xA;',&#xA;'  function checkAll() {&#xA;',&#xA;'    var bad = [];&#xA;',&#xA;'    Object.keys(checks).forEach(function (k) { if (!check(k)) { bad.push(k); } });&#xA;',&#xA;'    return bad;&#xA;',&#xA;'  }&#xA;',&#xA;'  /* Exception type: show the text box only for Other */&#xA;',&#xA;'  form.querySelectorAll(&quot;input[name=exceptionType]&quot;).forEach(function (r) {&#xA;',&#xA;'    r.addEventListener(&quot;change&quot;, function () {&#xA;',&#xA;'      var isOther = selectedType() === &quot;Other&quot;;&#xA;',&#xA;'      otherBox.hidden = !isOther;&#xA;',&#xA;'      otherInput.disabled = !isOther;&#xA;',&#xA;'      if (isOther) { otherInput.focus(); } else { mark(&quot;f_typeOther&quot;, true); }&#xA;',&#xA;'      check(&quot;f_type&quot;);&#xA;',&#xA;'    });&#xA;',&#xA;'  });&#xA;',&#xA;'  /* Counts: digits only - other keys are refused before they appear; leading zeros dropped */&#xA;',&#xA;'  countIds.forEach(function (id) {&#xA;',&#xA;'    var el = document.getElementById(id);&#xA;',&#xA;'    el.addEventListener(&quot;keydown&quot;, function (e) {&#xA;',&#xA;'      if (e.key &amp;&amp; e.key.length === 1 &amp;&amp; !e.ctrlKey &amp;&amp; !e.metaKey &amp;&amp; !e.altKey &amp;&amp; !/[0-9]/.test(e.key)) { e.preventDefault(); }&#xA;',&#xA;'    });&#xA;',&#xA;'    function insertDigits(text) {&#xA;',&#xA;'      var digits = text.replace(/[^0-9]/g, &quot;&quot;);&#xA;',&#xA;'      var start = el.selectionStart, end = el.selectionEnd;&#xA;',&#xA;'      el.value = (el.value.slice(0, start) + digits + el.value.slice(end)).slice(0, 9);&#xA;',&#xA;'      el.setSelectionRange(start + digits.length, start + digits.length);&#xA;',&#xA;'      el.dispatchEvent(new Event(&quot;input&quot;, { bubbles: true }));&#xA;',&#xA;'    }&#xA;',&#xA;'    el.addEventListener(&quot;beforeinput&quot;, function (e) {&#xA;',&#xA;'      if (e.data &amp;&amp; /[^0-9]/.test(e.data) &amp;&amp; e.inputType !== &quot;insertFromPaste&quot;) {&#xA;',&#xA;'        e.preventDefault();&#xA;',&#xA;'        if (e.data.length > 1) { insertDigits(e.data); } /* autocomplete, drag-drop: keep the digits */&#xA;',&#xA;'      }&#xA;',&#xA;'    });&#xA;',&#xA;'    el.addEventListener(&quot;paste&quot;, function (e) {&#xA;',&#xA;'      var text = (e.clipboardData || window.clipboardData).getData(&quot;text&quot;);&#xA;',&#xA;'      if (/[^0-9]/.test(text)) { e.preventDefault(); insertDigits(text); }&#xA;',&#xA;'    });&#xA;',&#xA;'    el.addEventListener(&quot;input&quot;, function () {&#xA;',&#xA;'      var clean = el.value.replace(/[^0-9]/g, &quot;&quot;);&#xA;',&#xA;'      if (clean !== el.value) { el.value = clean; }&#xA;',&#xA;'    });&#xA;',&#xA;'    el.addEventListener(&quot;blur&quot;, function () {&#xA;',&#xA;'      if (el.value !== &quot;&quot;) { el.value = String(parseInt(el.value, 10)); }&#xA;',&#xA;'    });&#xA;',&#xA;'  });&#xA;',&#xA;'  /* Re-check a field as soon as it changes */&#xA;',&#xA;'  Object.keys(checks).forEach(function (k) {&#xA;',&#xA;'    var box = document.getElementById(k);&#xA;',&#xA;'    if (!box) { return; }&#xA;',&#xA;'    [&quot;input&quot;, &quot;change&quot;, &quot;blur&quot;].forEach(function (ev) {&#xA;',&#xA;'      box.addEventListener(ev, function () { if (box.classList.contains(&quot;invalid&quot;)) { check(k); } }, true);&#xA;',&#xA;'    });&#xA;',&#xA;'  });&#xA;',&#xA;'  form.addEventListener(&quot;submit&quot;, function (e) {&#xA;',&#xA;'    var rejected = document.getElementById(&quot;serverRejectBanner&quot;);&#xA;',&#xA;'    if (rejected) { rejected.classList.remove(&quot;show&quot;); }&#xA;',&#xA;'    var bad = checkAll();&#xA;',&#xA;'    if (bad.length) {&#xA;',&#xA;'      e.preventDefault();&#xA;',&#xA;'      banner.textContent = bad.length === 1 ? &quot;1 field needs attention before you can submit.&quot; : bad.length + &quot; fields need attention before you can submit.&quot;;&#xA;',&#xA;'      banner.classList.add(&quot;show&quot;);&#xA;',&#xA;'      var first = document.getElementById(bad[0]).querySelector(&quot;input, select, textarea&quot;);&#xA;',&#xA;'      if (first &amp;&amp; !first.disabled) { first.focus(); }&#xA;',&#xA;'      document.getElementById(bad[0]).scrollIntoView({ block: &quot;center&quot;, behavior: &quot;smooth&quot; });&#xA;',&#xA;'      return;&#xA;',&#xA;'    }&#xA;',&#xA;'    banner.classList.remove(&quot;show&quot;);&#xA;',&#xA;'  });&#xA;',&#xA;'  form.addEventListener(&quot;reset&quot;, function () {&#xA;',&#xA;'    setTimeout(function () {&#xA;',&#xA;'      Object.keys(checks).forEach(function (k) { mark(k, true); });&#xA;',&#xA;'      banner.classList.remove(&quot;show&quot;);&#xA;',&#xA;'      otherBox.hidden = true; otherInput.disabled = true;&#xA;',&#xA;'      setNow();&#xA;',&#xA;'    }, 0);&#xA;',&#xA;'  });&#xA;',&#xA;'  /* Date and time defaults to now; reporting week runs Thursday to Wednesday */&#xA;',&#xA;'  function pad(n) { return (n &lt; 10 ? &quot;0&quot; : &quot;&quot;) + n; }&#xA;',&#xA;'  function setNow() {&#xA;',&#xA;'    var now = new Date();&#xA;',&#xA;'    document.getElementById(&quot;datetime&quot;).value = now.getFullYear() + &quot;-&quot; + pad(now.getMonth() + 1) + &quot;-&quot; + pad(now.getDate()) + &quot;T&quot; + pad(now.getHours()) + &quot;:&quot; + pad(now.getMinutes());&#xA;',&#xA;'  }&#xA;',&#xA;'  setNow();&#xA;',&#xA;'  (function () {&#xA;',&#xA;'    var d = new Date(); d.setHours(0, 0, 0, 0);&#xA;',&#xA;'    var iso = d.getDay() === 0 ? 7 : d.getDay();&#xA;',&#xA;'    var start = new Date(d); start.setDate(d.getDate() - ((iso + 3) % 7));&#xA;',&#xA;'    var end = new Date(start); end.setDate(start.getDate() + 6);&#xA;',&#xA;'    var f = function (x) { return x.toLocaleDateString(&quot;en-GB&quot;, { weekday: &quot;short&quot;, day: &quot;numeric&quot;, month: &quot;short&quot; }); };&#xA;',&#xA;'    document.getElementById(&quot;weekRange&quot;).textContent = f(start) + &quot; – &quot; + f(end);&#xA;',&#xA;'  })();&#xA;',&#xA;'  /* Code name search */&#xA;',&#xA;'  var active = -1;&#xA;',&#xA;'  function render(list) {&#xA;',&#xA;'    codeList.innerHTML = &quot;&quot;;&#xA;',&#xA;'    active = -1;&#xA;',&#xA;'    if (!list.length) {&#xA;',&#xA;'      var none = document.createElement(&quot;div&quot;);&#xA;',&#xA;'      none.className = &quot;combo-empty&quot;;&#xA;',&#xA;'      none.textContent = options.length ? &quot;No matching interface. You can keep what you typed.&quot; : &quot;No interfaces loaded.&quot;;&#xA;',&#xA;'      codeList.appendChild(none);&#xA;',&#xA;'    }&#xA;',&#xA;'    list.forEach(function (opt) {&#xA;',&#xA;'      var div = document.createElement(&quot;div&quot;);&#xA;',&#xA;'      div.className = &quot;combo-item&quot;;&#xA;',&#xA;'      div.setAttribute(&quot;role&quot;, &quot;option&quot;);&#xA;',&#xA;'      div.textContent = opt;&#xA;',&#xA;'      div.addEventListener(&quot;mousedown&quot;, function (e) { e.preventDefault(); pick(opt); });&#xA;',&#xA;'      codeList.appendChild(div);&#xA;',&#xA;'    });&#xA;',&#xA;'    codeList.classList.add(&quot;open&quot;);&#xA;',&#xA;'    codeInput.setAttribute(&quot;aria-expanded&quot;, &quot;true&quot;);&#xA;',&#xA;'  }&#xA;',&#xA;'  function close() { codeList.classList.remove(&quot;open&quot;); codeInput.setAttribute(&quot;aria-expanded&quot;, &quot;false&quot;); }&#xA;',&#xA;'  function pick(opt) { codeInput.value = opt; close(); check(&quot;f_code&quot;); }&#xA;',&#xA;'  function filter() {&#xA;',&#xA;'    var q = codeInput.value.toLowerCase();&#xA;',&#xA;'    render(options.filter(function (o) { return o.toLowerCase().indexOf(q) !== -1; }));&#xA;',&#xA;'  }&#xA;',&#xA;'  codeInput.addEventListener(&quot;focus&quot;, filter);&#xA;',&#xA;'  codeInput.addEventListener(&quot;input&quot;, filter);&#xA;',&#xA;'  codeInput.addEventListener(&quot;blur&quot;, function () { setTimeout(close, 120); });&#xA;',&#xA;'  codeInput.addEventListener(&quot;keydown&quot;, function (e) {&#xA;',&#xA;'    var items = codeList.querySelectorAll(&quot;.combo-item&quot;);&#xA;',&#xA;'    if (e.key === &quot;ArrowDown&quot; || e.key === &quot;ArrowUp&quot;) {&#xA;',&#xA;'      e.preventDefault();&#xA;',&#xA;'      if (!codeList.classList.contains(&quot;open&quot;)) { filter(); items = codeList.querySelectorAll(&quot;.combo-item&quot;); }&#xA;',&#xA;'      if (!items.length) { return; }&#xA;',&#xA;'      active = (active + (e.key === &quot;ArrowDown&quot; ? 1 : -1) + items.length) % items.length;&#xA;',&#xA;'      items.forEach(function (it, i) { it.classList.toggle(&quot;active&quot;, i === active); });&#xA;',&#xA;'      items[active].scrollIntoView({ block: &quot;nearest&quot; });&#xA;',&#xA;'    } else if (e.key === &quot;Enter&quot; &amp;&amp; active >= 0 &amp;&amp; items[active]) {&#xA;',&#xA;'      e.preventDefault(); pick(items[active].textContent);&#xA;',&#xA;'    } else if (e.key === &quot;Escape&quot;) { close(); }&#xA;',&#xA;'  });&#xA;',&#xA;'})();&#xA;',&#xA;'&lt;/script>&#xA;',&#xA;'&lt;/body>&#xA;',&#xA;'&lt;/html>&#xA;'&#xA;)"/>
                </param>
            </root>
        </pd:inputBindings>
    </pd:activity>
