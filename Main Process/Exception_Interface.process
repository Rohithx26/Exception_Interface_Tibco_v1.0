<?xml version="1.0" encoding="UTF-8"?>
<pd:ProcessDefinition xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:ns5="http://www.tibco.com/pe/GenerateErrorActivity/InputSchema" xmlns:pfx="http://www.tibco.com/namespaces/tnt/plugins/file/v2" xmlns:pd="http://xmlns.tibco.com/bw/process/2003" xmlns:ns="http://www.tibco.com/namespaces/tnt/plugins/file" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns0="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd" xmlns:tib="http://www.tibco.com/bw/xslt/custom-functions" xmlns:ns2="http://schemas.tibco.com/bw/plugins/file/5.0/fileExceptions" xmlns:ns1="http://www.tibco.com/pe/DeployedVarsType" xmlns:ns4="http://www.tibco.com/pe/EngineTypes" xmlns:ns3="http://schemas.tibco.com/bw/plugins/http/5.0/httpExceptions">
    <xsd:import namespace="http://www.tibco.com/schemas/Exception_Interface_Tibco/Shared Resources/Data/Schema.xsd" schemaLocation="/Shared Resources/Data/Schemas/Error_Handling.xsd"/>
    <pd:name>Main Process/Exception_Interface.process</pd:name>
    <pd:startName>HTTP Receiver</pd:startName>
    <pd:startX>0</pd:startX>
    <pd:startY>0</pd:startY>
    <pd:returnBindings/>
    <pd:starter name="HTTP Receiver">
        <pd:type>com.tibco.plugin.http.HTTPEventSource</pd:type>
        <pd:resourceType>httppalette.httpEventSource</pd:resourceType>
        <pd:x>86</pd:x>
        <pd:y>141</pd:y>
        <config>
            <outputMode>String</outputMode>
            <defaultEncoding>UTF-8</defaultEncoding>
            <inputOutputVersion>5.3.0</inputOutputVersion>
            <newMimeSupport>true</newMimeSupport>
            <sharedChannel>/Shared Resources/Connections/HTTP/HTTP Connection.sharedhttp</sharedChannel>
            <parsePostData>true</parsePostData>
            <customField>
                <row>
                    <attribute>application</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>codeName</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>datetime</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>description</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>closeNotes</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>assigned</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>exceptionType</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>exceptionTypeOther</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>exceptionsReceived</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>exceptionsFailed</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>exceptionsProcessed</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>kedbReference</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>kedbReferenceOthers</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
                <row>
                    <attribute>comments</attribute>
                    <attributeType>string</attributeType>
                    <attributeCard>repeating</attributeCard>
                </row>
            </customField>
            <Headers>
                <xsd:element name="root">
                    <xsd:complexType>
                        <xsd:sequence>
                            <xsd:element name="Accept" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Accept-Charset" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Accept-Encoding" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Content-Type" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Content-Length" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Connection" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Cookie" type="xsd:string" minOccurs="0"/>
                            <xsd:element name="Pragma" type="xsd:string" minOccurs="0"/>
                        </xsd:sequence>
                    </xsd:complexType>
                </xsd:element>
            </Headers>
        </config>
        <pd:inputBindings/>
    </pd:starter>
    <pd:endName>End</pd:endName>
    <pd:endX>955</pd:endX>
    <pd:endY>150</pd:endY>
    <pd:errorSchemas>
        <Schema0 ref="ns0:Error"/>
    </pd:errorSchemas>
    <pd:processVariables/>
    <pd:targetNamespace>http://xmlns.example.com/1752331323881</pd:targetNamespace>
    <pd:group name="Group">
        <pd:type>com.tibco.pe.core.CriticalSectionGroup</pd:type>
        <pd:resourceType>ae.process.group</pd:resourceType>
        <pd:x>160</pd:x>
        <pd:y>2</pd:y>
        <pd:width>571</pd:width>
        <pd:height>276</pd:height>
        <pd:collapsedWidth>57</pd:collapsedWidth>
        <pd:collapsedHeight>70</pd:collapsedHeight>
        <pd:groupVariables/>
        <pd:joinToggle>inherit</pd:joinToggle>
        <config>
            <pd:groupType>criticalSection</pd:groupType>
            <pd:serializable>false</pd:serializable>
            <pd:scope>single</pd:scope>
        </config>
        <pd:inputBindings/>
        <pd:expanded>true</pd:expanded>
        <pd:transition>
            <pd:from>start</pd:from>
            <pd:to>UserData</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Write End Log</pd:from>
            <pd:to>end</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>List Files</pd:from>
            <pd:to>Write CSV file</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>UserData</pd:from>
            <pd:to>Start Log Audit</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Start Log Audit</pd:from>
            <pd:to>Write Start Log</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Write Start Log</pd:from>
            <pd:to>Render User Data</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Write CSV file</pd:from>
            <pd:to>End Log Audit</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>End Log Audit</pd:from>
            <pd:to>Write End Log</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Render User Data</pd:from>
            <pd:to>Custom FileName</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:transition>
            <pd:from>Custom FileName</pd:from>
            <pd:to>List Files</pd:to>
            <pd:lineType>Default</pd:lineType>
            <pd:lineColor>-16777216</pd:lineColor>
            <pd:conditionType>always</pd:conditionType>
        </pd:transition>
        <pd:activity name="List Files">
            <pd:type>com.tibco.plugin.file.ListFilesActivity</pd:type>
            <pd:resourceType>ae.activities.ListFilesActivity</pd:resourceType>
            <pd:x>455</pd:x>
            <pd:y>197</pd:y>
            <config>
                <mode>only-files</mode>
            </config>
            <pd:inputBindings>
                <ns:ListFilesActivityConfig>
                    <fileName>
                        <xsl:value-of select="concat($_globalVariables/ns1:GlobalVariables/Directory/Working,$_globalVariables/ns1:GlobalVariables/Directory/Filename,'*',$_globalVariables/ns1:GlobalVariables/Directory/CSV_Wildcard)"/>
                    </fileName>
                </ns:ListFilesActivityConfig>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Custom FileName">
            <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
            <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
            <pd:x>425</pd:x>
            <pd:y>77</pd:y>
            <config>
                <element>
                    <xsd:element name="Custom_FileName">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="Filename" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </element>
            </config>
            <pd:inputBindings>
                <Custom_FileName>
                    <Filename>
                        <xsl:value-of select="concat(&#xA;  $_globalVariables/ns1:GlobalVariables/Directory/Working,$_globalVariables/ns1:GlobalVariables/Directory/Filename,&#xA;  tib:format-dateTime(&#xA;    'ddMMyyyy',&#xA;    tib:add-to-dateTime(&#xA;      current-dateTime(),&#xA;      0, 0,&#xA;      - ((number(tib:format-dateTime('u', current-dateTime())) + 3) mod 7),&#xA;      0, 0, 0&#xA;    )&#xA;  ),&#xA;$_globalVariables/ns1:GlobalVariables/Directory/CSV_Wildcard&#xA;)"/>
                    </Filename>
                </Custom_FileName>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="UserData">
            <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
            <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
            <pd:x>221</pd:x>
            <pd:y>78</pd:y>
            <config>
                <element>
                    <xsd:element name="Parameters">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="exceptionType" type="xsd:string"/>
                                <xsd:element name="application" type="xsd:string"/>
                                <xsd:element name="codeName" type="xsd:string"/>
                                <xsd:element name="date" type="xsd:string"/>
                                <xsd:element name="time" type="xsd:string"/>
                                <xsd:element name="description" type="xsd:string"/>
                                <xsd:element name="closeNotes" type="xsd:string"/>
                                <xsd:element name="assigned" type="xsd:string"/>
                                <xsd:element name="exceptionsReceived" type="xsd:string"/>
                                <xsd:element name="exceptionsFailed" type="xsd:string"/>
                                <xsd:element name="exceptionsProcessed" type="xsd:string"/>
                                <xsd:element name="kedbReference" type="xsd:string"/>
                                <xsd:element name="comments" type="xsd:string" minOccurs="0"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </element>
            </config>
            <pd:inputBindings>
                <Parameters>
                    <exceptionType>
                        <xsl:value-of select="if ($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionType[1] = 'Other') then concat('Other - ', normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionTypeOther[1])) else normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionType[1])"/>
                    </exceptionType>
                    <application>
                        <xsl:value-of select="$HTTP-Receiver/ProcessStarterOutput/parameters/application[1]"/>
                    </application>
                    <codeName>
                        <xsl:value-of select="$HTTP-Receiver/ProcessStarterOutput/parameters/codeName[1]"/>
                    </codeName>
                    <date>
                        <xsl:value-of select="substring-before($HTTP-Receiver/ProcessStarterOutput/parameters/datetime[1], 'T')"/>
                    </date>
                    <time>
                        <xsl:value-of select="substring-after($HTTP-Receiver/ProcessStarterOutput/parameters/datetime[1], 'T')"/>
                    </time>
                    <description>
                        <xsl:value-of select="if (starts-with(translate(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/description[1]), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'hi all,'))&#xA;then normalize-space(substring(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/description[1]), 8))&#xA;else if (starts-with(translate(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/description[1]), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'hello all,'))&#xA;then normalize-space(substring(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/description[1]), 11))&#xA;else if (starts-with(translate(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/description[1]), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'dear all,'))&#xA;then normalize-space(substring(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/description[1]), 10))&#xA;else if (starts-with(translate(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/description[1]), 'ABCDEFGHIJKLMNOPQRSTUVWXYZ', 'abcdefghijklmnopqrstuvwxyz'), 'all,'))&#xA;then normalize-space(substring(normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/description[1]), 5))&#xA;else normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/description[1])"/>
                    </description>
                    <closeNotes>
                        <xsl:value-of select="normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/closeNotes[1])"/>
                    </closeNotes>
                    <assigned>
                        <xsl:value-of select="$HTTP-Receiver/ProcessStarterOutput/parameters/assigned[1]"/>
                    </assigned>
                    <exceptionsReceived>
                        <xsl:value-of select="normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsReceived[1])"/>
                    </exceptionsReceived>
                    <exceptionsFailed>
                        <xsl:value-of select="normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsFailed[1])"/>
                    </exceptionsFailed>
                    <exceptionsProcessed>
                        <xsl:value-of select="normalize-space($HTTP-Receiver/ProcessStarterOutput/parameters/exceptionsProcessed[1])"/>
                    </exceptionsProcessed>
                    <kedbReference>
                        <xsl:value-of select="$HTTP-Receiver/ProcessStarterOutput/parameters/kedbReference[1]"/>
                    </kedbReference>
                    <xsl:if test="$HTTP-Receiver/ProcessStarterOutput/parameters/comments[1]">
                        <comments>
                            <xsl:value-of select="$HTTP-Receiver/ProcessStarterOutput/parameters/comments[1]"/>
                        </comments>
                    </xsl:if>
                </Parameters>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Render User Data">
            <pd:type>com.tibco.plugin.parse.RenderActivity</pd:type>
            <pd:resourceType>ae.activities.RenderActivity</pd:resourceType>
            <pd:x>350</pd:x>
            <pd:y>200</pd:y>
            <config>
                <ParseSharedConfig>/Shared Resources/Data/DataFormat/User_Input_Data.sharedparse</ParseSharedConfig>
            </config>
            <pd:inputBindings>
                <Rows>
                    <User_Input>
                        <exceptionType>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/exceptionType), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/exceptionType), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/exceptionType), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/exceptionType), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </exceptionType>
                        <application>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/application), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/application), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/application), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/application), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </application>
                        <codeName>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/codeName), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/codeName), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/codeName), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/codeName), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </codeName>
                        <date>
                            <xsl:value-of select="concat('&quot;', tib:format-date('dd-MM-yyyy', $UserData/Parameters/date), '&quot;')"/>
                        </date>
                        <time>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/time), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/time), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/time), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/time), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </time>
                        <description>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/description), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/description), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/description), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/description), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </description>
                        <closeNotes>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/closeNotes), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/closeNotes), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/closeNotes), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/closeNotes), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </closeNotes>
                        <assigned>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/assigned), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/assigned), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/assigned), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/assigned), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </assigned>
                        <exceptionsReceived>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/exceptionsReceived), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/exceptionsReceived), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/exceptionsReceived), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/exceptionsReceived), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </exceptionsReceived>
                        <exceptionsFailed>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/exceptionsFailed), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/exceptionsFailed), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/exceptionsFailed), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/exceptionsFailed), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </exceptionsFailed>
                        <exceptionsProcessed>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/exceptionsProcessed), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/exceptionsProcessed), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/exceptionsProcessed), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/exceptionsProcessed), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </exceptionsProcessed>
                        <kedbReference>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/kedbReference), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/kedbReference), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/kedbReference), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/kedbReference), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </kedbReference>
                        <comments>
                            <xsl:value-of select="concat('&quot;', if (normalize-space(translate(string($UserData/Parameters/comments), '&quot;', &quot;'&quot;)) != '' and contains('=+-@', substring(normalize-space(translate(string($UserData/Parameters/comments), '&quot;', &quot;'&quot;)), 1, 1))) then concat(&quot;'&quot;, normalize-space(translate(string($UserData/Parameters/comments), '&quot;', &quot;'&quot;))) else normalize-space(translate(string($UserData/Parameters/comments), '&quot;', &quot;'&quot;)), '&quot;')"/>
                        </comments>
                    </User_Input>
                </Rows>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Write CSV file">
            <pd:type>com.tibco.plugin.file.FileWriteActivity</pd:type>
            <pd:resourceType>ae.activities.FileWriteActivity</pd:resourceType>
            <pd:description>This will write the CSV file for the current week, which will be used until
the next week's cycle.</pd:description>
            <pd:x>537</pd:x>
            <pd:y>79</pd:y>
            <config>
                <encoding>text</encoding>
                <compressFile>None</compressFile>
                <append>true</append>
            </config>
            <pd:inputBindings>
                <ns:WriteActivityInputTextClass>
                    <fileName>
                        <xsl:value-of select="$Custom-FileName/Custom_FileName/Filename"/>
                    </fileName>
                    <textContent>
                        <xsl:value-of select="if ($List-Files/ns:ListFilesActivityOutput/files/fileInfo[&#xA;     fullName = $Custom-FileName/Custom_FileName/Filename&#xA;  ]&#xA;)&#xA;then&#xA;  $Render-User-Data/Text&#xA;else&#xA;  concat(&#xA;    'Exception Type',',','Application',',','CodeName',',','Date',',','Time',',','Description',',',&#xA;    'Close Notes',',','Assigned',',','Exceptions Received',',','Exceptions Failed',',','Exceptions Processed',',','KEDB Reference',',','Comments',&quot;&#xA;&quot;,&#xA;    $Render-User-Data/Text&#xA;  )"/>
                    </textContent>
                </ns:WriteActivityInputTextClass>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Start Log Audit">
            <pd:type>com.tibco.plugin.mapper.MapperActivity</pd:type>
            <pd:resourceType>ae.activities.MapperActivity</pd:resourceType>
            <pd:x>226</pd:x>
            <pd:y>202</pd:y>
            <config>
                <element>
                    <xsd:element name="LogEntry">
                        <xsd:complexType>
                            <xsd:sequence>
                                <xsd:element name="LogLine" type="xsd:string"/>
                            </xsd:sequence>
                        </xsd:complexType>
                    </xsd:element>
                </element>
            </config>
            <pd:inputBindings>
                <LogEntry>
                    <LogLine>
                        <xsl:value-of select="concat('START | ', tib:format-dateTime('yyyy-MM-dd', current-dateTime()), ' | ', tib:format-dateTime('HH:mm:ss', current-dateTime()), ' | ', $UserData/Parameters/assigned, ' | ', tib:format-dateTime('yyyy-MM-dd', current-dateTime()), 'T', tib:format-dateTime('HH:mm:ss', current-dateTime()), ' | FileWrite: N/A')"/>
                    </LogLine>
                </LogEntry>
            </pd:inputBindings>
        </pd:activity>
        <pd:activity name="Write Start Log">
